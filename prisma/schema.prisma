// Insof ERP — beton zavodi (tayyor beton / BSG)
// Asosiy prinsip: StockMove — yagona o'zgarmas harakat jurnali.
// Qoldiq hech qayerda saqlanmaydi, har doim yig'indi sifatida hisoblanadi.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Foydalanuvchilar / rollar ─────────────────────────

enum Role {
  DIRECTOR // to'liq huquq: hammasini ko'radi, sozlamalar, bloklarni ochadi
  SALES // sotuv
  PRODUCTION // ishlab chiqarish
  SUPERVISOR // ish boshqaruvchi: brigadalar, topshiriqlar, zameslar, reyslar
  LOGISTICS // logistika
  WAREHOUSE // sklad
  PROCUREMENT // snabjeniye
  ACCOUNTING // buxgalteriya
  FINANCE // finance
  HR // otdel kadr
  CASHIER // kassa / bank
  DRIVER // haydovchi — ERP login bilan kiradi (mobil ilova: o'z reyslari); vebda faqat "Mening reyslarim"
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders        Order[]             @relation("OrderCreatedBy")
  batches       ProductionBatch[]   @relation("BatchCreatedBy")
  stockMoves    StockMove[]         @relation("MoveCreatedBy")
  receipts      GoodsReceipt[]      @relation("ReceiptCreatedBy")
  tasks         BrigadeTask[]       @relation("TaskCreatedBy")
  taskProgress  TaskProgress[]      @relation("ProgressCreatedBy")
  cashTx        CashTransaction[]   @relation("CashTxCreatedBy")
  auditLogs     AuditLog[]
  employee      Employee?
  marketing     MarketingEntry[]    @relation("MarketingCreatedBy")
  telegram      TelegramAccount[]
  aiActions     AiAction[]
  telegramCodes TelegramLinkCode[]
  resetCodes    PasswordResetCode[]
  supplyReqs    SupplyRequest[]     @relation("SupplyCreatedBy")
  supplyEvents  SupplyEvent[]       @relation("SupplyEventBy")
  brigadeMoves  BrigadeMove[]       @relation("BrigadeMoveBy")
  leads         Lead[]              @relation("LeadHandledBy")
  salesRegister SalesRegister[]     @relation("SalesRegisterCreatedBy")
}

// ───────────────────────── Zavod rekvizitlari (bitta qator) ─────────────────────────

model CompanySettings {
  id              String   @id @default("main")
  name            String   @default("Insof beton zavodi")
  legalName       String? // yuridik nomi (MChJ)
  inn             String?
  address         String?
  // Zavod joyi — barcha masofa shu nuqtadan hisoblanadi (Sozlamalar sahifasida xaritadan belgilanadi)
  lat             Float?
  lng             Float?
  phone           String?
  phone2          String?
  email           String?
  bankName        String?
  bankAccount     String?
  mfo             String?
  directorName    String?
  about           String? // landing uchun qisqa matn
  workingHours    String?  @default("Dush–Shan 08:00–18:00")
  /// Kunlik ishlab chiqarish quvvati, m³ — Zayavkalar taqvimi shu chegaraga qarab rang beradi
  dailyCapacityM3 Decimal? @default(200) @db.Decimal(10, 2)
  foundedYear     Int?
  updatedAt       DateTime @updatedAt
}

// ───────────────────────── Spravochniklar ─────────────────────────

model Customer {
  id          String   @id @default(cuid())
  name        String
  inn         String?  @unique
  phone       String?
  address     String?
  creditLimit Decimal  @default(100000000) @db.Decimal(18, 2) // standart 100 mln; ishlatilgan qismi = qarz + ochiq zayavkalar; to'liq ishlatilsa — qora ro'yxat
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders   Order[]
  invoices Invoice[]
  payments Payment[]
  leads    Lead[]
  register SalesRegister[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  inn       String?  @unique
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  receipts       GoodsReceipt[]
  transactions   CashTransaction[]
  supplyRequests SupplyRequest[]
}

/// Xomashyo: sement, qum, shag'al (fraksiya bo'yicha), plastifikator, suv
model Material {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  unit      String // kg, t, l, m3
  minStock  Decimal  @default(0) @db.Decimal(18, 3) // shu miqdordan kam qolsa — signal
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  recipeItems  RecipeItem[]
  stockMoves   StockMove[]
  receiptItems GoodsReceiptItem[]
  supplyItems  SupplyRequestItem[]
  brigadeMoves BrigadeMove[]
}

/// Tayyor mahsulot: beton markasi (M300 / B22.5)
/// Mahsulot papkasi (1C dagi guruh): Plita > Gladki 12 > ... Ichma-ich bo'ladi.
/// Alohida jadval — mahsulot so'rovlari (sklad, retsept, BI) papkalarni ko'rmaydi.
model ProductGroup {
  id        String   @id @default(cuid())
  code      String   @unique // ro'yxatdagi "Kod" ustuni
  name      String
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  parent   ProductGroup?  @relation("GroupTree", fields: [parentId], references: [id])
  children ProductGroup[] @relation("GroupTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id            String   @id @default(cuid())
  code          String   @unique // M300
  name          String // Beton M300 (B22.5) P3
  strengthClass String? // B22.5
  unit          String   @default("m3")
  price         Decimal  @default(0) @db.Decimal(18, 2) // bazaviy narx (1 m3)
  kind          String? // "Tovar turi": Tayyor mahsulot, Tovar, Yarim tayyor...
  groupId       String? // papka; bo'sh bo'lsa ro'yxat ildizida turadi
  note          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  group      ProductGroup?     @relation(fields: [groupId], references: [id])
  recipes    Recipe[]
  orderItems OrderItem[]
  batches    ProductionBatch[]
  stockMoves StockMove[]
  leads      Lead[]

  @@index([groupId])
}

/// Retsept — 1 m3 uchun norma. Versiyalanadi, eski versiya o'chirilmaydi.
model Recipe {
  id        String   @id @default(cuid())
  productId String
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  product Product           @relation(fields: [productId], references: [id])
  items   RecipeItem[]
  batches ProductionBatch[]

  @@unique([productId, version])
}

model RecipeItem {
  id         String  @id @default(cuid())
  recipeId   String
  materialId String
  qtyPerM3   Decimal @db.Decimal(18, 3)

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@unique([recipeId, materialId])
}

model Warehouse {
  id       String  @id @default(cuid())
  name     String
  isActive Boolean @default(true)

  stockMoves     StockMove[]
  receipts       GoodsReceipt[]
  supplyRequests SupplyRequest[]
}

enum VehicleType {
  MIXER
  PUMP
  TRUCK
}

model Vehicle {
  id           String      @id @default(cuid())
  plate        String      @unique
  type         VehicleType
  capacityM3   Decimal?    @db.Decimal(8, 2)
  isActive     Boolean     @default(true)
  ecoVehicleId String?     @unique // Insof ECO Vehicle.id
  ecoSyncedAt  DateTime? // oxirgi muvaffaqiyatli sinxron (ikki tomonga)
  ecoError     String? // oxirgi sinxron xatosi

  trips   Trip[]
  drivers Employee[] @relation("DriverVehicle") // shu texnikaga biriktirilgan haydovchilar
}

model Employee {
  id          String    @id @default(cuid())
  fullName    String
  position    String // bo'lim lavozimi (Sotuv, Sklad...) yoki ishchi lavozim (Haydovchi, Operator...)
  tabelNo     String? // табельный номер — buxgalteriya tabelidagi raqam
  subdivision String? // подразделение — brigada / uchastka nomi
  tariffRate  Decimal?  @db.Decimal(18, 2) // тарифная ставка — kelishilgan tarif stavkasi
  phone       String?
  hiredAt     DateTime? // ishga kirgan sana — otdel kadr yuritadi
  firedAt     DateTime? // ishdan bo'shagan sana (to'ldirilsa xodim nofaol bo'ladi)
  birthDate   DateTime? // tug'ilgan sana
  note        String? // otdel kadr izohi (smena, manzil, hujjat holati...)
  isActive    Boolean   @default(true)

  // ── Kadr kartasi (otdel kadr to'ldiradi; shaxsiy varaqa va hujjat nusxalari) ──
  photo            String? // 3x4 surat — uploads/employees/ ichidagi nom
  passportSeries   String? // passport seriya va raqam, masalan AA 1234567
  pinfl            String? // JSHSHIR (14 raqam)
  passportIssuedBy String? // kim bergan (IIB)
  passportIssuedAt DateTime? // berilgan sana
  address          String? // yashash manzili
  education        String? // ma'lumoti
  maritalStatus    String? // oilaviy holati
  // ── Haydovchi kartasi (lavozimi haydovchi bo'lganda to'ldiriladi) ──
  licenseNo        String? // haydovchilik guvohnomasi raqami
  licenseCategory  String? // guvohnoma toifalari, masalan "B, C, CE"
  licenseExpiry    DateTime? // guvohnoma amal qilish muddati
  vehicleId        String? // biriktirilgan texnika (mikser/nasos)

  userId      String?   @unique // tizimga kiradigan xodim uchun login
  ecoUserId   String?   @unique // Insof ECO foydalanuvchi id (haydovchi ilovasi)
  ecoActive   Boolean? // ECO a'zoligi tasdiqlanganmi (null — ulanmagan)
  ecoSyncedAt DateTime? // oxirgi muvaffaqiyatli sinxron (ikki tomonga)
  ecoError    String? // oxirgi sinxron xatosi
  createdAt   DateTime  @default(now())

  user      User?              @relation(fields: [userId], references: [id])
  vehicle   Vehicle?           @relation("DriverVehicle", fields: [vehicleId], references: [id])
  trips     Trip[]             @relation("TripDriver")
  brigades  Brigade[]          @relation("BrigadeLeader")
  documents EmployeeDocument[]
}

/// Xodim hujjatining nusxasi (passport, diplom, tibbiy ma'lumotnoma...).
/// Fayl `uploads/employees/` da, bazada faqat nomi — `public/` ga qo'yilmaydi.
model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  kind       String // hujjat turi: Passport, Diplom, Tibbiy ma'lumotnoma, Haydovchilik guvohnomasi...
  file       String // uploads/employees/ ichidagi nom
  fileName   String // foydalanuvchi yuklagan asl nom
  fileType   String // MIME turi
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

/// Ishchi lavozim (login bermaydi) — otdel kadr o'zi qo'shadi/o'chiradi.
/// Bo'lim lavozimlari (rolli) kodda: `lib/positions.ts`.
model WorkPosition {
  id         String   @id @default(cuid())
  name       String   @unique
  note       String? // vazifasi / talab
  department String? // qaysi bo'lim tarkibida turadi (Role kaliti: PRODUCTION, LOGISTICS...) — tashkiliy tuzilma diagrammasi shu bo'yicha chiziladi
  isDriver   Boolean  @default(false) // haydovchi ilovasiga chiqadimi
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────────────────── Sklad: yagona harakat jurnali ─────────────────────────

enum StockMoveType {
  RECEIPT // yetkazuvchidan kirim
  PRODUCTION_CONSUME // zames uchun xomashyo chiqimi
  PRODUCTION_OUTPUT // tayyor beton kirimi
  SHIPMENT // mijozga jo'natish
  ADJUSTMENT // inventarizatsiya farqi
  WRITE_OFF // brak / yo'qotish
  BRIGADE_ISSUE // brigadaga berildi (skladdan chiqdi, brigada qoldig'iga o'tdi)
  BRIGADE_RETURN // brigadadan qaytdi
}

/// Har bir qator o'zgarmas. qty ishorali: kirim (+), chiqim (−).
/// Yo materialId, yo productId to'ldiriladi — ikkalasi emas.
model StockMove {
  id          String        @id @default(cuid())
  date        DateTime      @default(now())
  type        StockMoveType
  warehouseId String
  materialId  String?
  productId   String?
  brigadeId   String? // BRIGADE_ISSUE / BRIGADE_RETURN — qaysi brigada bilan harakat
  qty         Decimal       @db.Decimal(18, 3)
  unitCost    Decimal?      @db.Decimal(18, 2) // kirimda — tannarx hisobi uchun
  refType     String? // "GoodsReceipt" | "ProductionBatch" | "Trip"
  refId       String?
  note        String?
  createdById String
  createdAt   DateTime      @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  material  Material? @relation(fields: [materialId], references: [id])
  product   Product?  @relation(fields: [productId], references: [id])
  brigade   Brigade?  @relation(fields: [brigadeId], references: [id])
  createdBy User      @relation("MoveCreatedBy", fields: [createdById], references: [id])

  @@index([warehouseId, materialId, date])
  @@index([warehouseId, productId, date])
  @@index([refType, refId])
}

// ───────────────────────── Snabjeniye: kirim ─────────────────────────

model GoodsReceipt {
  id          String   @id @default(cuid())
  docNo       String   @unique
  date        DateTime @default(now())
  supplierId  String
  warehouseId String
  note        String?
  createdById String? // kirimni kiritgan sklad/snabjeniye xodimi — sotuvchi shu ma'lumotga tayanadi
  createdAt   DateTime @default(now())

  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy User?              @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  items     GoodsReceiptItem[]
  supply    SupplyRequest? // shu kirim ta'minot zayavkasidan tug'ilgan bo'lsa
}

model GoodsReceiptItem {
  id         String  @id @default(cuid())
  receiptId  String
  materialId String
  qty        Decimal @db.Decimal(18, 3)
  price      Decimal @db.Decimal(18, 2) // birlik narxi

  receipt  GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  material Material     @relation(fields: [materialId], references: [id])
}

// ───────────────────────── Ta'minot zayavkasi (sklad → snabjeniye → tasdiq → moliya → kirim) ─────────────────────────

/// Ta'minot zayavkasining bosqichlari. Har bosqichni boshqa bo'lim bajaradi —
/// kim, qachon va nima izoh bilan o'tkazgani `SupplyEvent` da qoladi.
enum SupplyStatus {
  NEW // Sklad kerakli mahsulotlar jadvalini tuzdi — snabjeniyeda narx kutilmoqda
  PRICED // Snabjeniye narx qo'ydi — Ta'minot zayavkalarida ma'sul xodim tasdig'i kutilmoqda
  APPROVED // Ma'sul xodim tasdiqladi — Moliya (Kirim-Chiqim) tasdig'i kutilmoqda (soat ikonkasi)
  FUNDED // Moliya tasdiqladi, reja summa chiqim bo'lib yozildi — snabjeniye sotib oladi
  RECEIVED // Snabjeniye mollarni tekshirib qabul qildi — sklad kirimi bo'ldi
  REJECTED // Bekor qilindi (qaysi bosqichda va nega — `SupplyEvent` da)
}

/// Skladga kerak bo'lgan mahsulotlar jadvali. Bitta hujjat butun zanjirdan o'tadi:
/// miqdor (sklad) → narx (snabjeniye) → tasdiq (ma'sul xodim) → pul (moliya) → fakt qabul (snabjeniye).
/// Reja summasi = Σ qty×price, fakt summasi = Σ factQty×factPrice.
model SupplyRequest {
  id               String       @id @default(cuid())
  docNo            String       @unique // TZ-YYYY-00001
  date             DateTime     @default(now())
  status           SupplyStatus @default(NEW)
  warehouseId      String
  needBy           DateTime? // qachongacha kerak
  note             String?
  supplierId       String? // snabjeniye belgilagan yetkazuvchi
  // ── Dostavka xizmati: molni kim va qancha pulga olib keladi ──
  deliveryKind     String? // "Yetkazuvchi yetkazadi" | "O'zimiz olib kelamiz" | "Transport xizmati"
  deliveryProvider String? // transport firma / haydovchi / mashina
  deliveryCost     Decimal      @default(0) @db.Decimal(18, 2) // kelishilgan dostavka narxi (jami summaga qo'shiladi)
  deliveryFactCost Decimal?     @db.Decimal(18, 2) // qabulda haqiqatda to'langan dostavka
  deliveryNote     String?
  /// Qabulda narx o'zgargani uchun necha marta qayta tasdiqqa qaytgani
  recheck          Int          @default(0)
  cashAccountId    String? // moliya qaysi hisobdan to'ladi
  cashTxId         String? // Kirim-Chiqimdagi yozuv (moliya tasdiqlaganda yaraladi, qabulda fakt summaga tuzatiladi)
  receiptId        String?      @unique // qabul qilinganda yaralgan kirim hujjati
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  cashAccount CashAccount?        @relation(fields: [cashAccountId], references: [id])
  receipt     GoodsReceipt?       @relation(fields: [receiptId], references: [id])
  createdBy   User                @relation("SupplyCreatedBy", fields: [createdById], references: [id])
  items       SupplyRequestItem[]
  events      SupplyEvent[]

  @@index([status, date])
}

/// Jadval qatori. Spravochnikda yo'q mahsulot ham yoziladi (`materialId` bo'sh, `name` bor) —
/// qabul qilinganda shu nom bilan xomashyo ochiladi.
model SupplyRequestItem {
  id         String   @id @default(cuid())
  requestId  String
  materialId String?
  name       String // yozilgan nom (spravochnikdagi nom yoki yangi nom)
  unit       String
  qty        Decimal  @db.Decimal(18, 3) // sklad so'ragan miqdor
  price      Decimal  @default(0) @db.Decimal(18, 2) // snabjeniye qo'ygan narx
  factQty    Decimal? @db.Decimal(18, 3) // qabulda haqiqatda kelgan miqdor
  factPrice  Decimal? @db.Decimal(18, 2) // qabulda haqiqatda kelgan narx
  prevPrice  Decimal? @db.Decimal(18, 2) // qayta tasdiqdan oldingi narx — tasdiqlovchi farqni ko'rsin
  note       String?
  sortOrder  Int      @default(0)

  request  SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  material Material?     @relation(fields: [materialId], references: [id])

  @@index([requestId])
}

/// Zanjirdagi har bir harakat: kim, qachon, qaysi bosqichga o'tkazdi, nima dedi.
model SupplyEvent {
  id        String       @id @default(cuid())
  requestId String
  stage     SupplyStatus // shu harakatdan keyingi holat
  note      String?
  userId    String
  createdAt DateTime     @default(now())

  request SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User          @relation("SupplyEventBy", fields: [userId], references: [id])

  @@index([requestId, createdAt])
}

// ───────────────────────── Brigada qoldig'i ─────────────────────────

enum BrigadeMoveType {
  ISSUE // skladdan brigadaga berildi (+)
  RETURN // brigadadan skladga qaytdi (−)
  CONSUME // topshiriq bajarilganda retsept bo'yicha sarflandi (−)
  WRITE_OFF // brak / yo'qotish (−)
}

/// Brigada qo'lidagi xomashyo — StockMove kabi o'zgarmas jurnal.
/// Qoldiq saqlanmaydi: brigada qoldig'i = Σ qty (ISSUE +, qolganlari −).
model BrigadeMove {
  id          String          @id @default(cuid())
  date        DateTime        @default(now())
  type        BrigadeMoveType
  brigadeId   String
  materialId  String
  qty         Decimal         @db.Decimal(18, 3) // ishorali: berildi (+), sarf/qaytdi (−)
  unitCost    Decimal?        @db.Decimal(18, 2)
  refType     String? // "StockMove" | "BrigadeTask"
  refId       String?
  note        String?
  createdById String
  createdAt   DateTime        @default(now())

  brigade   Brigade  @relation(fields: [brigadeId], references: [id])
  material  Material @relation(fields: [materialId], references: [id])
  createdBy User     @relation("BrigadeMoveBy", fields: [createdById], references: [id])

  @@index([brigadeId, materialId, date])
  @@index([refType, refId])
}

// ───────────────────────── Sotuv: zayavka ─────────────────────────

enum OrderStatus {
  DRAFT // sotuvchi kiritdi
  BLOCKED // kredit limit oshgan — direktor ochishi kerak
  CONFIRMED // ishlab chiqarishga tushdi
  IN_PRODUCTION
  DELIVERED
  CLOSED // to'lov yopildi
  CANCELLED
}

model Order {
  id               String      @id @default(cuid())
  orderNo          String      @unique
  date             DateTime    @default(now())
  customerId       String
  status           OrderStatus @default(DRAFT)
  deliveryDate     DateTime
  deliveryTime     String? // "HH:MM" — soat nechida yetkazish kerak (zayavka kirituvchi kiritadi)
  deliveryAddress  String
  // Obyekt nuqtasi — zayavka formasida xaritadan/qidiruvdan belgilanadi.
  // Bo'lmasa: haydovchida navigatsiya ishlamaydi, ETA taxminiy, "yetib bordi" avtomatik belgilanmaydi.
  lat              Float?
  lng              Float?
  /// Zavoddan obyektgacha masofa, km — yo'l bo'yicha (OSRM); OSRM javob bermasa to'g'ri chiziq
  distanceKm       Decimal?    @db.Decimal(8, 2)
  /// Masofa qanday olingan: ROUTE — yo'l bo'yicha, LINE — to'g'ri chiziq
  distanceSource   String?
  needsPump        Boolean     @default(false)
  needsDelivery    Boolean     @default(true) // dastavka kerakmi (yo'q bo'lsa mijoz o'zi olib ketadi)
  isUrgent         Boolean     @default(false) // zarur / shoshilinch
  onCredit         Boolean     @default(false) // qarzga — kafolat xati talab qilinadi
  guaranteeAt      DateTime? // mijoz imzolagan kafolat xati qabul qilingan sana
  contractNo       String?     @unique // shartnoma raqami (SH-YYYY-00001) — "Shartnoma qilish" belgilanganda
  contractAmount   Decimal?    @db.Decimal(18, 2) // shartnoma summasi; mahsulot summasi shundan ayiriladi (qoldiq)
  contractAt       DateTime? // shartnoma tuzilgan sana
  contractFile     String? // Didox'da imzolangan shartnoma fayli — uploads/contracts/ ichidagi nomi (isbot uchun tizimga yuklanadi)
  contractFileName String? // foydalanuvchi yuklagan asl fayl nomi
  contractFileType String? // MIME turi (application/pdf, image/jpeg ...)
  contractFileAt   DateTime? // fayl yuklangan vaqt
  note             String?
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer  Customer          @relation(fields: [customerId], references: [id])
  createdBy User              @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items     OrderItem[]
  batches   ProductionBatch[]
  trips     Trip[]
  invoices  Invoice[]
  tasks     BrigadeTask[]
  payments  Payment[] // oldindan to'lov (avans) — zayavka ochilganda olingan pul
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  qtyM3     Decimal @db.Decimal(18, 3)
  price     Decimal @db.Decimal(18, 2) // kelishilgan narx (1 m3)
  brigadeId String? // ishlab chiqarish bo'limida tayinlanadi; tasdiqlanganda topshiriq yaratiladi

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
  brigade Brigade?     @relation(fields: [brigadeId], references: [id])
  task    BrigadeTask?
}

// ───────────────────────── Brigadalar va topshiriqlar ─────────────────────────

model Brigade {
  id        String   @id @default(cuid())
  name      String
  leaderId  String? // brigadir (Employee)
  phone     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  leader     Employee?     @relation("BrigadeLeader", fields: [leaderId], references: [id])
  items      OrderItem[]
  tasks      BrigadeTask[]
  moves      BrigadeMove[]
  stockMoves StockMove[]
}

enum TaskStatus {
  NEW // yuborildi
  IN_PROGRESS // qisman bajarildi
  DONE // to'liq bajarildi
  CANCELLED
}

/// Zayavka qatori brigadaga topshiriq sifatida yuboriladi. qoldiq = qty − doneQty.
model BrigadeTask {
  id          String     @id @default(cuid())
  taskNo      String     @unique
  orderId     String
  orderItemId String     @unique
  brigadeId   String
  qty         Decimal    @db.Decimal(18, 3)
  doneQty     Decimal    @default(0) @db.Decimal(18, 3)
  status      TaskStatus @default(NEW)
  dueDate     DateTime
  note        String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  order     Order          @relation(fields: [orderId], references: [id])
  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  brigade   Brigade        @relation(fields: [brigadeId], references: [id])
  createdBy User           @relation("TaskCreatedBy", fields: [createdById], references: [id])
  progress  TaskProgress[]

  @@index([brigadeId, status])
}

/// Bajarilganlik qaydi: kim, qachon, qancha.
model TaskProgress {
  id          String   @id @default(cuid())
  taskId      String
  qty         Decimal  @db.Decimal(18, 3)
  date        DateTime @default(now())
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  task      BrigadeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User        @relation("ProgressCreatedBy", fields: [createdById], references: [id])
}

// ───────────────────────── Ishlab chiqarish: zames ─────────────────────────

/// Bitta zames (partiya). Saqlanganda retsept bo'yicha xomashyo
/// PRODUCTION_CONSUME sifatida StockMove'ga yoziladi.
model ProductionBatch {
  id          String   @id @default(cuid())
  batchNo     String   @unique
  date        DateTime @default(now())
  shift       Int      @default(1)
  orderId     String?
  productId   String
  recipeId    String
  qtyM3       Decimal  @db.Decimal(18, 3)
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  order     Order?  @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  recipe    Recipe  @relation(fields: [recipeId], references: [id])
  createdBy User    @relation("BatchCreatedBy", fields: [createdById], references: [id])
}

// ───────────────────────── Logistika: reys / nakladnoy ─────────────────────────

enum TripStatus {
  PLANNED
  LOADED
  ON_ROAD
  DELIVERED
  CANCELLED
}

model Trip {
  id             String     @id @default(cuid())
  deliveryNoteNo String     @unique // nakladnoy raqami (QR shu bo'yicha)
  orderId        String
  vehicleId      String
  driverId       String
  qtyM3          Decimal    @db.Decimal(18, 3)
  status         TripStatus @default(PLANNED)
  loadedAt       DateTime?
  deliveredAt    DateTime?
  receiverName   String? // obyektda kim qabul qildi
  note           String?
  createdAt      DateTime   @default(now())

  // ── Yukni olgan joyi (zavod/sklad) — logistika "Yuklandi" bosqichida belgilaydi ──
  pickupAddress String? // yuk olingan joy manzili
  pickupLat     Float? // xaritadagi nuqta — haydovchi ilovasida marshrut shu yerdan boshlanadi
  pickupLng     Float?

  // ── Insof ECO (haydovchi ilovasi) bilan sinxron ──
  ecoDeliveryId String?   @unique // ECO Delivery.id
  ecoStatus     String? // ECO holati: ASSIGNED, ACCEPTED, LOADING, EN_ROUTE, ARRIVED, UNLOADING, COMPLETED, DECLINED, FAILED, DISPUTED, CANCELLED
  ecoSyncedAt   DateTime? // oxirgi muvaffaqiyatli yuborish/qabul
  ecoError      String? // oxirgi xato (ko'rsatiladi, keyingi muvaffaqiyatda tozalanadi)

  order     Order          @relation(fields: [orderId], references: [id])
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id])
  driver    Employee       @relation("TripDriver", fields: [driverId], references: [id])
  positions TripPosition[]
}

/// Reys davomida haydovchi ilovasidan kelgan GPS nuqtalari.
///
/// Nega ECO'da emas: ECO'ning izi `tracking/gps` orqali ECO foydalanuvchisiga bog'lanadi,
/// zavod haydovchisi esa ERP logini bilan kiradi va ECO hisobiga ega emas. Tashqi
/// pudratchi haydovchilarining izi avvalgidek ECO'da qoladi — xarita ikkalasini qo'shib ko'rsatadi.
model TripPosition {
  id        String   @id @default(cuid())
  tripId    String
  lat       Float
  lng       Float
  speedKmh  Float?
  heading   Float?
  /// Qurilmadagi vaqt — nuqtalar aloqa uzilganda buferda turib, keyin to'p-to'p keladi
  at        DateTime
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, at])
}

// ───────────────────────── Moliya: schyot / to'lov / kassa ─────────────────────────

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

model Invoice {
  id         String        @id @default(cuid())
  invoiceNo  String        @unique
  date       DateTime      @default(now())
  customerId String
  orderId    String?
  amount     Decimal       @db.Decimal(18, 2)
  status     InvoiceStatus @default(OPEN)
  createdAt  DateTime      @default(now())

  customer Customer  @relation(fields: [customerId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  payments Payment[]
}

enum CashAccountType {
  CASH
  BANK
}

model CashAccount {
  id       String          @id @default(cuid())
  name     String
  type     CashAccountType
  isActive Boolean         @default(true)

  payments       Payment[]
  transactions   CashTransaction[]
  supplyRequests SupplyRequest[]
  register       SalesRegister[]

  // Bir xil nomli hisob ikki marta ochilmasin (seed qayta ishga tushsa ham)
  @@unique([name, type])
}

enum CashTxType {
  INCOME // kirim (mijoz to'lovidan tashqari: boshqa tushumlar)
  EXPENSE // chiqim
}

/// Kirim-Chiqim jurnali. Mijoz to'lovlari Payment'da — bu yerda boshqa kirim va barcha chiqimlar.
model CashTransaction {
  id            String     @id @default(cuid())
  date          DateTime   @default(now())
  type          CashTxType
  cashAccountId String
  amount        Decimal    @db.Decimal(18, 2)
  category      String // "Xomashyo", "Ish haqi", "Transport", ...
  counterparty  String? // kimga / kimdan
  supplierId    String?
  note          String?
  refType       String? // qaysi hujjatdan avtomatik yozilgan: "GoodsReceipt" | "StockIn"
  refId         String? // shu hujjat id'si — Kirim-Chiqimdan batafsilga o'tish uchun
  createdById   String
  createdAt     DateTime   @default(now())

  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id])
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  createdBy   User        @relation("CashTxCreatedBy", fields: [createdById], references: [id])

  @@index([date, type])
}

model Payment {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  customerId    String
  invoiceId     String?
  orderId       String? // avans: zayavka ochilganda olingan pul; schyot yozilganda unga bog'lanadi
  cashAccountId String
  amount        Decimal  @db.Decimal(18, 2)
  note          String?
  createdAt     DateTime @default(now())

  customer    Customer       @relation(fields: [customerId], references: [id])
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id])
  order       Order?         @relation(fields: [orderId], references: [id])
  cashAccount CashAccount    @relation(fields: [cashAccountId], references: [id])
  register    SalesRegister?

  @@index([orderId])
}

/// Realizatsiya jurnali — buxgalteriya Excel'da yuritadigan kunlik jo'natma jadvali
/// (Число, № маш, Наименование, ТТН, К-во, Кому, Цена, НДС, Итого Сумма...).
/// Kassa/bank sahifasiga Excel orqali yuklanadi: har qator o'z holicha saqlanadi va
/// "Деньги" ustuniga qarab pul naqd kassaga (н-к) yoki bank hisobiga (п-р) Payment sifatida tushadi.
/// Mijoz bo'yicha ko'rish: /payments/mijoz/<customerId>.
model SalesRegister {
  id            String   @id @default(cuid())
  date          DateTime // "Число"
  customerId    String // "Кому"
  vehicleNo     String? // "№ маш" — mashina raqami (matn; texnika ro'yxatiga bog'lanmaydi)
  ttn           String? // "ТТН" — nakladnoy raqami
  productName   String // "Наименование": Beton M250, PK 61-10-8 ...
  unit          String   @default("m3") // "Ед Изм"
  qty           Decimal  @db.Decimal(18, 3) // "К-во"
  fromWho       String? // "От Кого" — ИНСОФ
  payType       String? // "Деньги": п-р (o'tkazma) | н-к (naqd)
  deliveryFee   Decimal  @default(0) @db.Decimal(18, 2) // "Доставка"
  price         Decimal  @default(0) @db.Decimal(18, 2) // "Цена"
  sum           Decimal  @default(0) @db.Decimal(18, 2) // "Общие Сумма"
  nds           Decimal  @default(0) @db.Decimal(18, 2) // "НДС 12%"
  total         Decimal  @default(0) @db.Decimal(18, 2) // "Итого Сумма" — kassaga tushadigan summa
  address       String? // "Адрес"
  contractNo    String? // "Договор Номер"
  invoiceNo     String? // "Счёт Фактура"
  monthNo       String? // "Ой"
  note          String? // "Изох"
  cashAccountId String? // qaysi kassa/hisobga yozildi
  paymentId     String?  @unique // shu qatordan yozilgan kassa kirimi (o'chirilsa birga o'chadi)
  batch         String // bitta import partiyasi — jurnalda guruhlanadi va butunlay o'chiriladi
  createdById   String
  createdAt     DateTime @default(now())

  customer    Customer     @relation(fields: [customerId], references: [id])
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
  payment     Payment?     @relation(fields: [paymentId], references: [id])
  createdBy   User         @relation("SalesRegisterCreatedBy", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([date])
  @@index([batch])
}

// ───────────────────────── Audit ─────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // CREATE | UPDATE | DELETE | STATUS_CHANGE
  entity    String // "Order", "StockMove" ...
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}

// ───────────────────────── BI: reja va marketing ─────────────────────────

/// Oylik sotuv rejasi. sellerId = null — butun zavod rejasi; sellerId — sotuvchi (User) rejasi.
model SalesPlan {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  sellerId  String?
  amount    Decimal  @db.Decimal(18, 2)
  volumeM3  Decimal? @db.Decimal(18, 3)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, sellerId])
  @@index([year, month])
}

enum MarketingEntryKind {
  BUDGET // ajratilgan pul
  PLAN // natija maqsadlari
  FACT // to'langan xarajat va natija
}

/// Marketing ma'lumotlari: oy × kanal × tur (byudjet / reja / fakt).
model MarketingEntry {
  id          String             @id @default(cuid())
  year        Int
  month       Int
  kind        MarketingEntryKind
  channel     String
  amount      Decimal            @db.Decimal(18, 2)
  leads       Int?
  customers   Int?
  revenue     Decimal?           @db.Decimal(18, 2)
  impressions Int?
  clicks      Int?
  note        String?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy User @relation("MarketingCreatedBy", fields: [createdById], references: [id])

  @@index([year, month])
}

// ───────────────────────── Telegram bot ─────────────────────────

/// Botga yozayotgan Telegram chat. userId bo'lsa — ERP foydalanuvchisiga bog'langan (faqat shunda javob beriladi).
model TelegramAccount {
  id        String    @id @default(cuid())
  chatId    String    @unique // Telegram chat id (shaxsiy yozishma)
  userId    String?
  username  String?
  firstName String?
  isBlocked Boolean   @default(false) // direktor uzib qo'ysa
  linkedAt  DateTime?
  lastSeen  DateTime  @default(now())
  createdAt DateTime  @default(now())

  user     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TelegramMessage[]

  @@index([userId])
}

/// Bir martalik ulash kodi. Sozlamalar → Telegram bot'da yaratiladi, botga yuboriladi.
model TelegramLinkCode {
  code      String    @id // 6 xonali
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Bot orqali kelgan savol va javob — audit va suhbat konteksti uchun.
model TelegramMessage {
  id        String   @id @default(cuid())
  accountId String
  kind      String // voice | text
  question  String // ovoz bo'lsa — matnga aylantirilgani
  answer    String
  level     Int      @default(0) // 0 — qoida, 2 — Claude
  latencyMs Int?
  createdAt DateTime @default(now())

  account TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

/// AI agent tayyorlagan amal (zayavka ochish, to'lov qabul qilish…) — bazaga yozishdan
/// oldin foydalanuvchi tasdig'ini kutadi. Tasdiqlangach `actions.ts` uni bajaradi.
/// Argumentlar tayyorlash bosqichida tekshirilgan va id'larga keltirilgan holda saqlanadi.
model AiAction {
  id        String    @id @default(cuid())
  userId    String
  kind      String // order_create, payment_add, …
  args      Json // tekshirilgan, id'larga keltirilgan argumentlar
  summary   String // foydalanuvchiga ko'rsatiladigan tasdiq matni
  warnings  String? // ogohlantirishlar (qatorma-qator)
  status    String    @default("PENDING") // PENDING | DONE | CANCELLED | FAILED
  source    String // telegram | panel
  chatId    String? // Telegram chat (tugma bosilganda kimga javob berish)
  result    String? // bajarilgandan keyingi natija yoki xato matni
  createdAt DateTime  @default(now())
  expiresAt DateTime
  doneAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

// ───────────────────────── SMS (Eskiz) ─────────────────────────

/// Yuborilgan har bir SMS. Ikki vazifasi bor: xarajat nazorati (oyiga nechta ketdi)
/// va "yubordikmi?" savoliga javob. `text` da parol/kod MASKALANGAN holda yoziladi —
/// jurnalni ko'rgan odam begona parolni o'qiy olmasin.
model SmsLog {
  id        String   @id @default(cuid())
  phone     String // +998XXXXXXXXX ko'rinishida normallashtirilgan
  template  String // shablon kaliti: login_granted, password_changed, reset_code
  text      String // yuborilgan matn, maxfiy qismi ••• bilan almashtirilgan
  status    String // SENT | FAILED | SKIPPED
  provider  String // eskiz | fake
  error     String? // FAILED bo'lsa sabab
  userId    String? // kimga tegishli (bo'lsa)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([createdAt])
}

/// Parolni tiklash uchun bir martalik SMS kodi (`/login/reset`).
/// Kodning o'zi saqlanmaydi — faqat bcrypt xeshi. Muddati va urinishlar soni cheklangan.
model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  phone     String // kod yuborilgan raqam (normallashtirilgan)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([phone, createdAt])
}

enum LeadStatus {
  NEW // hali hech kim ko'tarmagan
  IN_PROGRESS // sotuv bog'landi, kelishilmoqda
  CONVERTED // mijozga aylandi
  REJECTED // bekor — qiziqmadi, mos kelmadi
}

/// Saytdagi "Ariza qoldirish" formasidan tushgan so'rov (`/` landing sahifasi).
/// Mijoz bazasiga darhol yozilmaydi: sotuv bo'limi bog'lanib, kerak bo'lsa
/// `/leads` sahifasidan bitta tugma bilan `Customer` ga aylantiradi.
model Lead {
  id          String     @id @default(cuid())
  name        String
  phone       String // normallashtirilgan: +998XXXXXXXXX
  productId   String? // saytdagi ro'yxatdan tanlangan mahsulot
  qty         Decimal?   @db.Decimal(18, 3) // taxminiy hajm (mahsulot birligida)
  address     String? // obyekt manzili
  message     String?
  source      String     @default("landing") // keyinchalik: telegram, instagram…
  status      LeadStatus @default(NEW)
  note        String? // sotuvchining ichki izohi
  customerId  String? // CONVERTED bo'lganda — yaratilgan/topilgan mijoz
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime   @default(now())

  product   Product?  @relation(fields: [productId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  handledBy User?     @relation("LeadHandledBy", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@index([phone])
}
