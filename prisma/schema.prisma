// Insof ERP — beton zavodi (tayyor beton / BSG)
// Asosiy prinsip: StockMove — yagona o'zgarmas harakat jurnali.
// Qoldiq hech qayerda saqlanmaydi, har doim yig'indi sifatida hisoblanadi.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Foydalanuvchilar / rollar ─────────────────────────

enum Role {
  DIRECTOR // to'liq huquq: hammasini ko'radi, sozlamalar, bloklarni ochadi
  SALES // sotuv
  PRODUCTION // ishlab chiqarish
  SUPERVISOR // ish boshqaruvchi: brigadalar, topshiriqlar, zameslar, reyslar
  LOGISTICS // logistika
  WAREHOUSE // sklad
  PROCUREMENT // snabjeniye
  ACCOUNTING // buxgalteriya
  FINANCE // finance
  HR // otdel kadr
  CASHIER // kassa / bank
  MECHANIC // mexanik — bosh sahifasi "Sklad & Logistika" nazorati: bugun/ertaga zayavka, mahsulot ehtiyoji, qoldiq, transport
  DRIVER // haydovchi — ERP login bilan kiradi (mobil ilova: o'z reyslari); vebda faqat "Mening reyslarim"
  BRIGADIER // brigadir — ERP login bilan kiradi (mobil ilova: o'z brigadasi topshiriqlari); vebda faqat "Mening topshiriqlarim"
  AGENT // ko'chadagi sotuv agenti — o'z mijozlari, zayavka ochish, mijozlar qarzi (mobil + cheklangan veb)
  SUPERADMIN // IT (platforma egasi) — markaziy paneldan SSO bilan kiradi; korxona ichida direktor huquqi + IT kuzatuv.
  // Direktor bu hisobni ko'rmaydi, o'zgartira olmaydi; login/parol bilan kirib bo'lmaydi (faqat SSO).
}

model User {
  id             String   @id @default(cuid())
  login          String   @unique
  passwordHash   String
  fullName       String
  role           Role
  isActive       Boolean  @default(true)
  /// Har oshirilganda shu hisobning barcha veb/mobil tokenlari kuyadi (parol almashdi, hisob yopildi)
  sessionVersion Int      @default(0)
  /// Insof ECO ilovasi hisobi: direktor ruxsat bergan bo'lsa, ERP'ga ilovadagi telefon + parol bilan kiradi
  /// (parolni ECO tekshiradi). Bunday hisobning `passwordHash` i tasodifiy — login/parol bilan kirib bo'lmaydi.
  ecoUserId      String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders            Order[]                  @relation("OrderCreatedBy")
  batches           ProductionBatch[]        @relation("BatchCreatedBy")
  stockMoves        StockMove[]              @relation("MoveCreatedBy")
  receipts          GoodsReceipt[]           @relation("ReceiptCreatedBy")
  tasks             BrigadeTask[]            @relation("TaskCreatedBy")
  taskProgress      TaskProgress[]           @relation("ProgressCreatedBy")
  cashTx            CashTransaction[]        @relation("CashTxCreatedBy")
  auditLogs         AuditLog[]
  employee          Employee?
  marketing         MarketingEntry[]         @relation("MarketingCreatedBy")
  telegram          TelegramAccount[]
  aiActions         AiAction[]
  telegramCodes     TelegramLinkCode[]
  resetCodes        PasswordResetCode[]
  supplyReqs        SupplyRequest[]          @relation("SupplyCreatedBy")
  supplyEvents      SupplyEvent[]            @relation("SupplyEventBy")
  supplyResponsible SupplyRequest[]          @relation("SupplyResponsible")
  supplyQuotes      SupplyQuote[]            @relation("SupplyQuoteBy")
  supplyIncidents   SupplyIncident[]         @relation("SupplyIncidentBy")
  supplyDocuments   SupplyDocument[]         @relation("SupplyDocBy")
  brigadeMoves      BrigadeMove[]            @relation("BrigadeMoveBy")
  leads             Lead[]                   @relation("LeadHandledBy")
  salesRegister     SalesRegister[]          @relation("SalesRegisterCreatedBy")
  devices           MobileDevice[]
  notifications     Notification[]
  deletionRequests  AccountDeletionRequest[] @relation("DeletionRequestUser")
  deletionHandled   AccountDeletionRequest[] @relation("DeletionRequestHandledBy")
  productionPlans   ProductionPlan[]         @relation("PlanSetBy")
  expenseBudgets    ExpenseBudget[]          @relation("BudgetSetBy")
  defects           ProductDefect[]          @relation("DefectCreatedBy")
  productionReports ProductionReport[]       @relation("ProdReportBy")
  shiftsOpened      BrigadeShift[]           @relation("ShiftOpenedBy")
  shiftsClosed      BrigadeShift[]           @relation("ShiftClosedBy")
  brigadeIssues     BrigadeIssue[]           @relation("BrigadeIssueBy")
  brigadeIssuesDone BrigadeIssue[]           @relation("BrigadeIssueResolvedBy")
  payments          Payment[]                @relation("PaymentCreatedBy")
  vehicleServices   VehicleService[]         @relation("VehicleServiceBy")
  agentCustomers    Customer[]               @relation("CustomerAgent")
  aiChats           AiChat[]                 @relation("AiChatUser")
  /// Modul bo'yicha qo'shimcha ruxsat (direktor beradi): { "modul": "view" | "write" }. Rol ustiga qo'shiladi/cheklaydi.
  perms             Json?
}

// ───────────────────────── Zavod rekvizitlari (bitta qator) ─────────────────────────

model CompanySettings {
  id                  String    @id @default("main")
  /// Platforma (superadmin) korxonani to'xtatgan bo'lsa — xodimlar veb va mobilda kira olmaydi, ma'lumot saqlanadi
  suspendedAt         DateTime?
  suspendReason       String?
  name                String    @default("Insof beton zavodi")
  legalName           String? // yuridik nomi (MChJ)
  inn                 String?
  address             String?
  // Zavod joyi — barcha masofa shu nuqtadan hisoblanadi (Sozlamalar sahifasida xaritadan belgilanadi)
  lat                 Float?
  lng                 Float?
  phone               String?
  phone2              String?
  email               String?
  bankName            String?
  bankAccount         String?
  mfo                 String?
  directorName        String?
  about               String? // landing uchun qisqa matn
  workingHours        String?   @default("Dush–Shan 08:00–18:00")
  // ── Mijoz ilovasi (do'kon) "bugungi holat" — ish vaqti matni (workingHours) ko'rsatish uchun, bular hisob uchun ──
  openHour            Int       @default(8) // qabul boshlanadi (Toshkent vaqti)
  closeHour           Int       @default(18) // qabul tugaydi
  workSunday          Boolean   @default(false) // yakshanba ham ishlaydimi
  sameDayCutoffHour   Int       @default(14) // shu soatgacha buyurtma — shu kuni yetkaziladi
  telegram            String? // mijozlar yozadigan Telegram (@username yoki t.me havola)
  /// Kunlik ishlab chiqarish quvvati, m³ — Zayavkalar taqvimi shu chegaraga qarab rang beradi
  dailyCapacityM3     Decimal?  @default(200) @db.Decimal(10, 2)
  /// Kunlik zayavka chegaralari (direktor sozlaydi; 0/bo'sh — cheklov yo'q). orderConfirm shu bo'yicha rad etadi.
  dailyOrderMaxM3     Decimal?  @db.Decimal(12, 2)
  dailyOrderMaxCount  Int?
  foundedYear         Int?
  // ── Egasi dashbordi chegaralari (norma / e'tibor / kritik) — direktor Byudjet sahifasida sozlaydi ──
  alertWarnPct        Int       @default(90) // byudjetning shu foizidan oshsa — e'tibor
  alertCritPct        Int       @default(100) // shu foizdan oshsa — kritik
  stockWarnDays       Int       @default(7) // xomashyo shu kundan kamga yetsa — e'tibor
  stockCritDays       Int       @default(3) // shu kundan kamga yetsa — kritik (ishlab chiqarish to'xtash xavfi)
  overdueDays         Int       @default(30) // schyot shu kundan eski bo'lsa — muddati o'tgan debitorka
  // ── Logistika chegaralari — /logistika/sozlamalar da logistika rahbari sozlaydi ──
  lateWarnMin         Int       @default(15) // reys rejadagi vaqtdan shuncha daqiqa kechiksa — e'tibor
  lateCritMin         Int       @default(45) // shuncha daqiqa — kritik
  gpsSilentMin        Int       @default(15) // yo'ldagi mashinadan GPS shuncha daqiqa kelmasa — ogohlantirish
  loadedWarnMin       Int       @default(30) // yuklangan beton zavoddan shuncha daqiqa chiqmasa — ogohlantirish (qotish xavfi)
  assignLeadMin       Int       @default(60) // yetkazishga shuncha daqiqa qolganda reyssiz zayavka — kritik
  shiftStartHour      Int       @default(8) // transport smenasi boshlanishi (bandlik foizi uchun)
  shiftEndHour        Int       @default(20) // smena tugashi
  avgSpeedKmh         Int       @default(35) // shahar ichida o'rtacha tezlik — GPS bo'lmaganda ETA taxmini
  // ── Snabjeniye: shu summadan (so'm) katta xarid avval direktor tasdig'idan o'tadi; 0 — cheklov yo'q ──
  supplyDirectorLimit Decimal   @default(50000000) @db.Decimal(18, 2)
  /// "To'lanmagan kirimlar" shu sanadan keyingi kirimlarni ko'rsatadi (bo'sh — 2026-09-30); eski chiqimsiz kirimlar to'lov kutmaydi
  payablesSince       DateTime?
  updatedAt           DateTime  @updatedAt
}

// ───────────────────────── Spravochniklar ─────────────────────────

model Customer {
  id            String   @id @default(cuid())
  name          String
  inn           String?  @unique
  phone         String?
  address       String?
  /// Mas'ul shaxs (F.I.O., lavozimi) — Excel importi va karta uchun
  contactPerson String?
  creditLimit   Decimal  @default(0) @db.Decimal(18, 2) // yangi mijozga 0 (direktor/moliya oshiradi); ishlatilgan qismi = qarz + ochiq zayavkalar; to'liq ishlatilsa — qora ro'yxat
  /// Ichki "mijoz" — haqiqiy mijoz emas, tizimning o'zi ishlatadi (sklad zaxirasi zayavkasi shu nomga ochiladi).
  /// Mijozlar ro'yxati, limit, reyting va ECO sinxronidan chiqarib tashlanadi.
  isInternal    Boolean  @default(false)
  isActive      Boolean  @default(true)
  /// Ko'chadagi sotuv agenti (bu mijozni olib kelgan / yurituvchi). Agent o'z mijozlari va ularning qarzini ko'radi.
  agentId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sites         Site[]

  orders   Order[]
  invoices Invoice[]
  payments Payment[]
  leads    Lead[]
  register SalesRegister[]
  agent    User?            @relation("CustomerAgent", fields: [agentId], references: [id])
  openings OpeningBalance[]

  @@index([agentId])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  inn           String?  @unique
  phone         String?
  address       String?
  /// Mas'ul shaxs (F.I.O., lavozimi)
  contactPerson String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  receipts       GoodsReceipt[]
  openings       OpeningBalance[]
  transactions   CashTransaction[]
  supplyRequests SupplyRequest[]
  supplyQuotes   SupplyQuote[]
}

/// Xomashyo: sement, qum, shag'al (fraksiya bo'yicha), plastifikator, suv
model Material {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  unit      String // kg, t, l, m3
  minStock  Decimal  @default(0) @db.Decimal(18, 3) // shu miqdordan kam qolsa — signal
  groupId   String? // papka; bo'sh bo'lsa ro'yxat ildizida turadi
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  group        MaterialGroup?      @relation(fields: [groupId], references: [id])
  recipeItems  RecipeItem[]
  stockMoves   StockMove[]
  receiptItems GoodsReceiptItem[]
  supplyItems  SupplyRequestItem[]
  brigadeMoves BrigadeMove[]

  @@index([groupId])
}

/// Xomashyo papkasi (mahsulot papkasining aynan o'zi, faqat xomashyo uchun):
/// Sement > Toshkent, Inertlar > Qum ... Ichma-ich bo'ladi.
/// Xomashyo so'rovlari (retsept, sklad, ta'minot) papkalarni ko'rmaydi — ro'yxat ko'rinishi uchun.
model MaterialGroup {
  id        String   @id @default(cuid())
  code      String   @unique // ro'yxatdagi "Kod" ustuni
  name      String
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  parent    MaterialGroup?  @relation("MaterialGroupTree", fields: [parentId], references: [id])
  children  MaterialGroup[] @relation("MaterialGroupTree")
  materials Material[]

  @@index([parentId])
}

/// Tayyor mahsulot: beton markasi (M300 / B22.5)
/// Mahsulot papkasi (1C dagi guruh): Plita > Gladki 12 > ... Ichma-ich bo'ladi.
/// Alohida jadval — mahsulot so'rovlari (sklad, retsept, BI) papkalarni ko'rmaydi.
model ProductGroup {
  id        String   @id @default(cuid())
  code      String   @unique // ro'yxatdagi "Kod" ustuni
  name      String
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  parent   ProductGroup?  @relation("GroupTree", fields: [parentId], references: [id])
  children ProductGroup[] @relation("GroupTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id            String   @id @default(cuid())
  code          String   @unique // M300
  name          String // Beton M300 (B22.5) P3
  strengthClass String? // B22.5
  unit          String   @default("m3")
  price         Decimal  @default(0) @db.Decimal(18, 2) // bazaviy narx (1 m3)
  kind          String? // "Tovar turi": Tayyor mahsulot, Tovar, Yarim tayyor...
  groupId       String? // papka; bo'sh bo'lsa ro'yxat ildizida turadi
  note          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  group       ProductGroup?     @relation(fields: [groupId], references: [id])
  recipes     Recipe[]
  recipeItems RecipeItem[]      @relation("RecipeIngredientProduct")
  orderItems  OrderItem[]
  batches     ProductionBatch[]
  stockMoves  StockMove[]
  leads       Lead[]
  shopItem    ShopItem?
  banners     ShopBanner[]
  plans       ProductionPlan[]
  defects     ProductDefect[]
  openings    OpeningBalance[]

  @@index([groupId])
}

/// E-commerce vitrinasi (Insof ECO ilovasidagi do'kon): qaysi mahsulot ko'rinadi, surati,
/// tavsifi va do'kon narxi. Mahsulotning o'zi (`Product`) o'zgarmaydi — bu faqat ko'rinish qatlami.
/// Bo'sh `title`/`price` — mahsulotning o'z nomi/narxi olinadi.
model ShopItem {
  id          String   @id @default(cuid())
  productId   String   @unique
  isPublished Boolean  @default(false)
  title       String?
  description String?
  photo       String? // uploads/shop/<stored>
  price       Decimal? @db.Decimal(18, 2)
  minQty      Decimal? @db.Decimal(18, 3) // eng kam buyurtma (mahsulot birligida)
  badge       String? // "Yangi", "Chegirma", "Top"
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Do'kon reklamasi (ADS) — ilova bosh sahifasidagi swiper'da ko'rinadigan banner.
/// Boshqaruv: ERP `/e-commerce?tab=reklama`. Muddati bo'lsa faqat shu oraliqda ko'rinadi.
model ShopBanner {
  id         String    @id @default(cuid())
  title      String
  subtitle   String?
  image      String? // uploads/shop/<stored> — bo'lmasa rangli fon + matn
  productId  String? // bosilganda shu mahsulot ochiladi (bo'lmasa katalog)
  buttonText String? // "Batafsil", "Buyurtma berish"
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

/// Retsept — 1 m3 uchun norma. Versiyalanadi, eski versiya o'chirilmaydi.
model Recipe {
  id        String   @id @default(cuid())
  productId String
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  product Product           @relation(fields: [productId], references: [id])
  items   RecipeItem[]
  batches ProductionBatch[]

  @@unique([productId, version])
}

/// Retsept qatori: yo xomashyo (materialId), yo boshqa mahsulot (productId) — ikkalasi emas.
/// Mahsulotga ruxsat berilgani ko'p bosqichli tayyorlov uchun: masalan katta konstruksiyaga
/// tayyor FBS blok kabi boshqa mahsulot ham kirishi mumkin (StockMove dagi bilan bir xil qoida).
model RecipeItem {
  id         String  @id @default(cuid())
  recipeId   String
  materialId String?
  productId  String?
  qtyPerM3   Decimal @db.Decimal(18, 3)

  recipe   Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id])
  product  Product?  @relation("RecipeIngredientProduct", fields: [productId], references: [id])

  @@unique([recipeId, materialId])
  @@unique([recipeId, productId])
}

model Warehouse {
  id        String  @id @default(cuid())
  name      String
  isActive  Boolean @default(true)
  /// Asosiy sklad: reys yuklash, brigada chiqargan mahsulot va brak shu skladdan boshlab ishlaydi (bittasi)
  isDefault Boolean @default(false)

  stockMoves     StockMove[]
  receipts       GoodsReceipt[]
  supplyRequests SupplyRequest[]
  openings       OpeningBalance[]
}

enum VehicleType {
  MIXER
  PUMP
  TRUCK
}

/// Texnika holati — egasi dashbordidagi "Transport" bloki uchun. Ishda/bo'sh reyslardan bilinadi,
/// ta'mir va bekor turishni logistika qo'lda belgilaydi (Haydovchilar sahifasi).
enum VehicleStatus {
  ACTIVE // saflda — reysga chiqadi
  REPAIR // ta'mirda
  IDLE // bekor turibdi (haydovchi yo'q, buyurtma yo'q, hujjat...)
}

model Vehicle {
  id           String        @id @default(cuid())
  plate        String        @unique
  type         VehicleType
  capacityM3   Decimal?      @db.Decimal(8, 2)
  isActive     Boolean       @default(true)
  status       VehicleStatus @default(ACTIVE)
  statusNote   String? // ta'mir sababi / bekor turish sababi
  statusSince  DateTime? // holat qachondan — bekor turish narxi shu sanadan hisoblanadi
  ecoVehicleId String?       @unique // Insof ECO Vehicle.id
  ecoSyncedAt  DateTime? // oxirgi muvaffaqiyatli sinxron (ikki tomonga)
  ecoError     String? // oxirgi sinxron xatosi

  // ── Transport kartasi (Logistika → Transport) ──
  brand            String? // marka: Howo, Shacman, Kamaz...
  model            String? // modeli
  year             Int? // ishlab chiqarilgan yili
  fuelType         FuelType? // yoqilg'i turi
  fuelNormL100     Decimal?  @db.Decimal(6, 2) // yoqilg'i normasi, l / 100 km — sarf nazorati uchun
  odometerKm       Int? // oxirgi ma'lum probeg (zapravkada yoziladi)
  hasGps           Boolean   @default(false) // doimiy GPS-treker o'rnatilgan (telefon GPS'idan tashqari)
  inspectionUntil  DateTime? // texnik ko'rik muddati
  insuranceCompany String? // sug'urta kompaniyasi
  insurancePolicy  String? // polis raqami
  insuranceUntil   DateTime? // sug'urta muddati
  note             String?

  trips    Trip[]
  drivers  Employee[]         @relation("DriverVehicle") // shu texnikaga biriktirilgan haydovchilar
  fuelLogs FuelLog[]
  expenses TransportExpense[]
  services VehicleService[]
}

/// Texnik xizmat jurnali (mexanik): moy almashtirish, ta'mir, shina, ko'rik — keyingi xizmat muddati bilan
model VehicleService {
  id          String    @id @default(cuid())
  vehicleId   String
  date        DateTime  @default(now())
  kind        String // xizmat turi: "Moy almashtirish", "Ta'mir", "Shina", "Texnik ko'rik"...
  odometerKm  Int? // xizmat paytidagi probeg
  cost        Decimal?  @db.Decimal(18, 2)
  note        String?
  nextDueAt   DateTime? // keyingi xizmat sanasi
  nextDueKm   Int? // keyingi xizmat probegi
  createdById String
  createdAt   DateTime  @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy User    @relation("VehicleServiceBy", fields: [createdById], references: [id])

  @@index([vehicleId, date])
}

enum FuelType {
  DIESEL // dizel
  PETROL // benzin
  METHANE // metan
  PROPANE // propan
}

model Employee {
  id          String    @id @default(cuid())
  fullName    String
  position    String // bo'lim lavozimi (Sotuv, Sklad...) yoki ishchi lavozim (Haydovchi, Operator...)
  tabelNo     String? // табельный номер — buxgalteriya tabelidagi raqam
  subdivision String? // подразделение — brigada / uchastka nomi
  tariffRate  Decimal?  @db.Decimal(18, 2) // тарифная ставка — kelishilgan tarif stavkasi
  phone       String?
  hiredAt     DateTime? // ishga kirgan sana — otdel kadr yuritadi
  firedAt     DateTime? // ishdan bo'shagan sana (to'ldirilsa xodim nofaol bo'ladi)
  firedReason String? // bo'shatish sababi — "Ishdan bo'shatish" tugmasi yozadi
  birthDate   DateTime? // tug'ilgan sana
  note        String? // otdel kadr izohi (smena, manzil, hujjat holati...)
  isActive    Boolean   @default(true)

  // ── Kadr kartasi (otdel kadr to'ldiradi; shaxsiy varaqa va hujjat nusxalari) ──
  photo            String? // 3x4 surat — uploads/employees/ ichidagi nom
  passportSeries   String? // passport seriya va raqam, masalan AA 1234567
  pinfl            String? // JSHSHIR (14 raqam)
  passportIssuedBy String? // kim bergan (IIB)
  passportIssuedAt DateTime? // berilgan sana
  address          String? // yashash manzili
  education        String? // ma'lumoti
  maritalStatus    String? // oilaviy holati
  // ── Haydovchi kartasi (lavozimi haydovchi bo'lganda to'ldiriladi) ──
  licenseNo        String? // haydovchilik guvohnomasi raqami
  licenseCategory  String? // guvohnoma toifalari, masalan "B, C, CE"
  licenseExpiry    DateTime? // guvohnoma amal qilish muddati
  vehicleId        String? // biriktirilgan texnika (mikser/nasos)
  workSchedule     String? // ish grafigi: "08:00–20:00, 2/2", "Tungi smena" — dispetcher uchun
  /// Ishlab chiqarishdagi brigadasi — direktor taqsimlaydi (Bosh sahifa → Ishlab chiqarish → Xodimlarni taqsimlash).
  /// Brigadaga biriktirilgan xodim sex tarkibida sanaladi (lavozimi boshqa bo'lim bo'lsa ham).
  brigadeId        String?

  userId      String?   @unique // tizimga kiradigan xodim uchun login
  ecoUserId   String?   @unique // Insof ECO foydalanuvchi id (haydovchi ilovasi)
  ecoActive   Boolean? // ECO a'zoligi tasdiqlanganmi (null — ulanmagan)
  ecoSyncedAt DateTime? // oxirgi muvaffaqiyatli sinxron (ikki tomonga)
  ecoError    String? // oxirgi sinxron xatosi
  createdAt   DateTime  @default(now())

  user             User?                    @relation(fields: [userId], references: [id])
  vehicle          Vehicle?                 @relation("DriverVehicle", fields: [vehicleId], references: [id])
  brigade          Brigade?                 @relation("BrigadeMembers", fields: [brigadeId], references: [id], onDelete: SetNull)
  trips            Trip[]                   @relation("TripDriver")
  brigades         Brigade[]                @relation("BrigadeLeader")
  documents        EmployeeDocument[]
  hrDocs           HrDocument[]
  attendance       Attendance[]
  deletionRequests AccountDeletionRequest[]
  fuelLogs         FuelLog[]
  transportCosts   TransportExpense[]
}

/// Xodim hujjatining nusxasi (passport, diplom, tibbiy ma'lumotnoma...).
/// Fayl `uploads/employees/` da, bazada faqat nomi — `public/` ga qo'yilmaydi.
model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  kind       String // hujjat turi: Passport, Diplom, Tibbiy ma'lumotnoma, Haydovchilik guvohnomasi...
  file       String // uploads/employees/ ichidagi nom
  fileName   String // foydalanuvchi yuklagan asl nom
  fileType   String // MIME turi
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
}

/// Otdel kadr shakllari — tizimda to'ldirilib chop etiladigan hujjatlar
/// (ariza, anketa, mehnat shartnomasi, tilxat, moddiy javobgarlik, buyruq, bo'shatish arizasi).
/// Matni kodda (`lib/hr-docs.ts`), bu yerda faqat to'ldiriladigan maydonlar va imzolangan nusxa.
enum HrDocKind {
  ARIZA // ishga qabul qilish arizasi
  ANKETA // Insof anketasi — shaxsiy varaqa
  SHARTNOMA // mehnat shartnomasi
  TILXAT // xodimning majburiyatlari tilxati
  JAVOBGARLIK // to'liq moddiy javobgarlik shartnomasi
  BUYRUQ // ishga qabul qilish buyrug'i
  BOSHATISH // ishdan bo'shatish (o'z xohishi bilan) arizasi
}

model HrDocument {
  id          String    @id @default(cuid())
  employeeId  String
  kind        HrDocKind
  no          String? // hujjat raqami — buyruqda «216 K» ko'rinishida
  docDate     DateTime  @db.Date // hujjat tuzilgan sana
  effectiveAt DateTime? @db.Date // kuchga kirish sanasi: ishga qabul / bo'shatish sanasi
  position    String? // hujjatda yozilgan lavozim — keyin karta o'zgarsa ham hujjat o'zgarmaydi
  salary      Decimal?  @db.Decimal(18, 2) // shartnomadagi oylik ish haqi
  fixedTerm   Boolean   @default(false) // muddatli shartnomami (false — muddatsiz)
  termUntil   DateTime? @db.Date // muddatli bo'lsa — qaysi sanagacha
  reason      String? // bo'shatish sababi yoki izoh

  // Imzolangan nusxa — skanerdan/telefondan yuklanadi, `uploads/employees/` da saqlanadi
  file     String?
  fileName String?
  fileType String?
  signedAt DateTime? // imzolangan nusxa yuklangan vaqt

  createdById String? // kim tayyorlagani (User.id)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([kind, docDate])
}

/// Bir xodimning bir kunlik davomati — otdel kadr "Davomat" tabidan belgilaydi.
/// Yozuv yo'q kun = belgilanmagan (tabelda bo'sh katak).
model Attendance {
  id             String           @id @default(cuid())
  employeeId     String
  date           DateTime         @db.Date // kun, soatsiz
  status         AttendanceStatus @default(PRESENT)
  checkIn        String? // keldi, "HH:MM" — faqat ishga chiqqan kun uchun
  checkOut       String? // ketdi, "HH:MM"; kelishdan oldin bo'lsa tungi smena deb hisoblanadi
  note           String?
  markedById     String? // kim belgilagani (User.id) — auditda ham qoladi
  // "Keldi" yuz bilan tasdiqlangan bo'lsa: kamera kadri (`uploads/employees/`) va tasdiq vaqti.
  // Qo'lda belgilangan yozuvda ikkalasi ham bo'sh — tabelda farqi ko'rinadi.
  facePhoto      String?
  faceVerifiedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([date])
}

/// Tabeldagi belgilar. `PRESENT` dan boshqasida soat yozilmaydi.
enum AttendanceStatus {
  PRESENT // keldi
  ABSENT // kelmadi (sababsiz)
  LEAVE // ta'til
  SICK // kasal
  DAYOFF // dam olish / bayram
}

/// Ishchi lavozim (login bermaydi) — otdel kadr o'zi qo'shadi/o'chiradi.
/// Bo'lim lavozimlari (rolli) kodda: `lib/positions.ts`.
model WorkPosition {
  id         String   @id @default(cuid())
  name       String   @unique
  note       String? // vazifasi / talab
  department String? // qaysi bo'lim tarkibida turadi (Role kaliti: PRODUCTION, LOGISTICS...) — tashkiliy tuzilma diagrammasi shu bo'yicha chiziladi
  isDriver   Boolean  @default(false) // haydovchi ilovasiga chiqadimi
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────────────────── Sklad: yagona harakat jurnali ─────────────────────────

enum StockMoveType {
  RECEIPT // yetkazuvchidan kirim
  PRODUCTION_CONSUME // zames uchun xomashyo chiqimi
  PRODUCTION_OUTPUT // tayyor beton kirimi
  SHIPMENT // mijozga jo'natish
  ADJUSTMENT // inventarizatsiya farqi
  WRITE_OFF // brak / yo'qotish
  BRIGADE_ISSUE // brigadaga berildi (skladdan chiqdi, brigada qoldig'iga o'tdi)
  BRIGADE_RETURN // brigadadan qaytdi
}

/// Har bir qator o'zgarmas. qty ishorali: kirim (+), chiqim (−).
/// Yo materialId, yo productId to'ldiriladi — ikkalasi emas.
model StockMove {
  id          String        @id @default(cuid())
  date        DateTime      @default(now())
  type        StockMoveType
  warehouseId String
  materialId  String?
  productId   String?
  brigadeId   String? // BRIGADE_ISSUE / BRIGADE_RETURN — qaysi brigada bilan harakat
  qty         Decimal       @db.Decimal(18, 3)
  unitCost    Decimal?      @db.Decimal(18, 2) // kirimda — tannarx hisobi uchun
  refType     String? // "GoodsReceipt" | "ProductionBatch" | "Trip"
  refId       String?
  note        String?
  /// Formadagi bir martalik kalit — ikki marta bosilgan "qo'shish" ikkinchi harakat yozmasin
  clientToken String?       @unique
  createdById String
  createdAt   DateTime      @default(now())

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  material  Material?       @relation(fields: [materialId], references: [id])
  product   Product?        @relation(fields: [productId], references: [id])
  brigade   Brigade?        @relation(fields: [brigadeId], references: [id])
  createdBy User            @relation("MoveCreatedBy", fields: [createdById], references: [id])
  opening   OpeningBalance?

  @@index([warehouseId, materialId, date])
  @@index([warehouseId, productId, date])
  @@index([refType, refId])
}

// ───────────────────────── Snabjeniye: kirim ─────────────────────────

model GoodsReceipt {
  id            String    @id @default(cuid())
  docNo         String    @unique
  date          DateTime  @default(now())
  supplierId    String
  warehouseId   String
  note          String?
  createdById   String? // kirimni kiritgan sklad/snabjeniye xodimi — sotuvchi shu ma'lumotga tayanadi
  createdAt     DateTime  @default(now())
  /// Formadagi bir martalik kalit — ikki marta bosilgan "Saqlash" ikkinchi kirim ochmasin
  clientToken   String?   @unique
  /// Storno: kirim bekor qilingan (sklad harakatlari teskari yozilgan) — kim, qachon, nima sababdan
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy User?              @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  items     GoodsReceiptItem[]
  supply    SupplyRequest? // shu kirim ta'minot zayavkasidan tug'ilgan bo'lsa
}

model GoodsReceiptItem {
  id         String  @id @default(cuid())
  receiptId  String
  materialId String
  qty        Decimal @db.Decimal(18, 3)
  price      Decimal @db.Decimal(18, 2) // birlik narxi

  receipt  GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  material Material     @relation(fields: [materialId], references: [id])

  @@index([receiptId])
}

// ───────────────────────── Ta'minot zayavkasi (sklad → snabjeniye → tasdiq → moliya → kirim) ─────────────────────────

/// Ta'minot zayavkasining bosqichlari. Har bosqichni boshqa bo'lim bajaradi —
/// kim, qachon va nima izoh bilan o'tkazgani `SupplyEvent` da qoladi.
enum SupplyStatus {
  NEW // Sklad kerakli mahsulotlar jadvalini tuzdi — snabjeniyeda narx kutilmoqda
  PRICED // Snabjeniye narx qo'ydi — Ta'minot zayavkalarida ma'sul xodim tasdig'i kutilmoqda
  APPROVED // Ma'sul xodim tasdiqladi — Moliya (Kirim-Chiqim) tasdig'i kutilmoqda (soat ikonkasi)
  FUNDED // Moliya tasdiqladi, reja summa chiqim bo'lib yozildi — snabjeniye sotib oladi
  RECEIVED // Snabjeniye mollarni tekshirib qabul qildi — sklad kirimi bo'ldi
  REJECTED // Bekor qilindi (qaysi bosqichda va nega — `SupplyEvent` da)
}

/// Skladga kerak bo'lgan mahsulotlar jadvali. Bitta hujjat butun zanjirdan o'tadi:
/// miqdor (sklad) → narx (snabjeniye) → tasdiq (ma'sul xodim) → pul (moliya) → fakt qabul (snabjeniye).
/// Reja summasi = Σ qty×price, fakt summasi = Σ factQty×factPrice.
model SupplyRequest {
  id               String          @id @default(cuid())
  docNo            String          @unique // TZ-YYYY-00001
  date             DateTime        @default(now())
  status           SupplyStatus    @default(NEW)
  warehouseId      String
  needBy           DateTime? // qachongacha kerak
  note             String?
  supplierId       String? // snabjeniye belgilagan yetkazuvchi
  // ── Dostavka xizmati: molni kim va qancha pulga olib keladi ──
  deliveryKind     String? // "Yetkazuvchi yetkazadi" | "O'zimiz olib kelamiz" | "Transport xizmati"
  deliveryProvider String? // transport firma / haydovchi / mashina
  deliveryCost     Decimal         @default(0) @db.Decimal(18, 2) // kelishilgan dostavka narxi (jami summaga qo'shiladi)
  deliveryFactCost Decimal?        @db.Decimal(18, 2) // qabulda haqiqatda to'langan dostavka
  deliveryNote     String?
  /// Qabulda narx o'zgargani uchun necha marta qayta tasdiqqa qaytgani
  recheck          Int             @default(0)
  cashAccountId    String? // moliya qaysi hisobdan to'ladi
  cashTxId         String? // Kirim-Chiqimdagi yozuv (moliya tasdiqlaganda yaraladi, qabulda fakt summaga tuzatiladi)
  receiptId        String?         @unique // qabul qilinganda yaralgan kirim hujjati
  // ── Talabnoma rekvizitlari (Snabjeniye TZ): qaysi bo'lim so'radi, qanchalik shoshilinch, kim javob beradi ──
  department       String? // Ishlab chiqarish | Sklad | Texnika | ... (`lib/procurement.ts` DEPARTMENTS)
  priority         SupplyPriority  @default(NORMAL)
  responsibleId    String? // mas'ul snabjeniye xodimi
  contractNo       String? // yetkazuvchi bilan shartnoma raqami
  // ── Katta xarid: `supplyDirectorLimit` dan oshsa, sotuv tasdig'idan oldin direktor tasdiqlaydi ──
  directorOkAt     DateTime?
  directorOkById   String?
  // ── Yetkazib berish monitoringi (pul ajratilgandan keyin snabjeniye yuritadi) ──
  deliveryStatus   SupplyDelivery?
  shippedAt        DateTime? // yetkazuvchi jo'natgan sana
  eta              DateTime? // kutilayotgan sana
  arrivedAt        DateTime? // zavodga yetib kelgan vaqt
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  cashAccount CashAccount?        @relation(fields: [cashAccountId], references: [id])
  receipt     GoodsReceipt?       @relation(fields: [receiptId], references: [id])
  createdBy   User                @relation("SupplyCreatedBy", fields: [createdById], references: [id])
  responsible User?               @relation("SupplyResponsible", fields: [responsibleId], references: [id])
  items       SupplyRequestItem[]
  events      SupplyEvent[]
  quotes      SupplyQuote[]
  incidents   SupplyIncident[]
  documents   SupplyDocument[]

  @@index([status, date])
  @@index([supplierId])
}

/// Jadval qatori. Spravochnikda yo'q mahsulot ham yoziladi (`materialId` bo'sh, `name` bor) —
/// qabul qilinganda shu nom bilan xomashyo ochiladi.
model SupplyRequestItem {
  id         String   @id @default(cuid())
  requestId  String
  materialId String?
  name       String // yozilgan nom (spravochnikdagi nom yoki yangi nom)
  unit       String
  qty        Decimal  @db.Decimal(18, 3) // sklad so'ragan miqdor
  price      Decimal  @default(0) @db.Decimal(18, 2) // snabjeniye qo'ygan narx
  factQty    Decimal? @db.Decimal(18, 3) // qabulda haqiqatda kelgan miqdor
  factPrice  Decimal? @db.Decimal(18, 2) // qabulda haqiqatda kelgan narx
  prevPrice  Decimal? @db.Decimal(18, 2) // qayta tasdiqdan oldingi narx — tasdiqlovchi farqni ko'rsin
  note       String?
  sortOrder  Int      @default(0)

  request  SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  material Material?     @relation(fields: [materialId], references: [id])

  @@index([requestId])
}

/// Zanjirdagi har bir harakat: kim, qachon, qaysi bosqichga o'tkazdi, nima dedi.
model SupplyEvent {
  id        String       @id @default(cuid())
  requestId String
  stage     SupplyStatus // shu harakatdan keyingi holat
  note      String?
  userId    String
  createdAt DateTime     @default(now())

  request SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User          @relation("SupplyEventBy", fields: [userId], references: [id])

  @@index([requestId, createdAt])
}

/// Talabnoma ustuvorligi — so'rovchi yoki snabjeniye belgilaydi. Kritik xomashyo va kechikish
/// hisobda baribir ko'tariladi (`lib/procurement-home.ts`), bu maydon — qo'lda qo'yilgan daraja.
enum SupplyPriority {
  NORMAL
  HIGH
  CRITICAL
}

/// Yetkazib berish holati — pul ajratilgandan (FUNDED) keyin snabjeniye yangilab boradi.
/// Zanjir bosqichi (SupplyStatus) bilan aralashmaydi: RECEIVED qabul bilan avtomatik qo'yiladi.
enum SupplyDelivery {
  PLANNED // buyurtma berildi, jo'natilmagan
  IN_TRANSIT // yo'lda
  ARRIVED // zavodga yetib keldi
  RECEIVING // sklad qabul qilmoqda
  RECEIVED // qabul qilindi
  PROBLEM // muammo (kechikish, kam miqdor, sifat) — SupplyIncident da tafsiloti
}

enum SupplyIncidentKind {
  SHORTAGE // kam miqdor
  QUALITY // sifatsiz mahsulot
  DELAY // kechikish
  DOCS // hujjat yetishmaydi
  OTHER
}

/// Tijorat taklifi — bitta talabnoma bo'yicha bir nechta yetkazuvchidan narx olinadi,
/// bittasi tanlanadi (tanlangani zayavkaning yetkazuvchisi bo'ladi).
model SupplyQuote {
  id           String    @id @default(cuid())
  requestId    String
  supplierId   String?
  supplierName String // spravochnikda yo'q yetkazuvchi ham yoziladi
  amount       Decimal   @db.Decimal(18, 2) // jami taklif summasi
  deliveryDays Int? // necha kunda yetkazadi
  paymentTerms String? // "100% oldindan", "50/50", "kechiktirilgan 15 kun"
  validUntil   DateTime?
  note         String?
  chosen       Boolean   @default(false)
  createdById  String
  createdAt    DateTime  @default(now())

  request   SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier  Supplier?     @relation(fields: [supplierId], references: [id])
  createdBy User          @relation("SupplyQuoteBy", fields: [createdById], references: [id])

  @@index([requestId])
}

/// Xarid bo'yicha muammo: kam miqdor, sifat, kechikish, hujjat. Hal qilinmaguncha dashboardda alert.
model SupplyIncident {
  id           String             @id @default(cuid())
  requestId    String
  kind         SupplyIncidentKind
  note         String
  createdById  String
  createdAt    DateTime           @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?

  request   SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy User          @relation("SupplyIncidentBy", fields: [createdById], references: [id])

  @@index([requestId])
  @@index([resolvedAt])
}

/// Xaridga biriktirilgan fayl: shartnoma, hisob-faktura, nakladnoy, sertifikat.
/// Fayl `uploads/supply/` da, faqat login talab qiladigan marshrut orqali beriladi.
model SupplyDocument {
  id          String   @id @default(cuid())
  requestId   String
  kind        String // Shartnoma | Hisob-faktura | Nakladnoy | Sertifikat | Boshqa
  file        String
  fileName    String
  fileType    String
  createdById String
  createdAt   DateTime @default(now())

  request   SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy User          @relation("SupplyDocBy", fields: [createdById], references: [id])

  @@index([requestId])
}

// ───────────────────────── Brigada qoldig'i ─────────────────────────

enum BrigadeMoveType {
  ISSUE // skladdan brigadaga berildi (+)
  RETURN // brigadadan skladga qaytdi (−)
  CONSUME // topshiriq bajarilganda retsept bo'yicha sarflandi (−)
  WRITE_OFF // brak / yo'qotish (−)
}

/// Brigada qo'lidagi xomashyo — StockMove kabi o'zgarmas jurnal.
/// Qoldiq saqlanmaydi: brigada qoldig'i = Σ qty (ISSUE +, qolganlari −).
model BrigadeMove {
  id          String          @id @default(cuid())
  date        DateTime        @default(now())
  type        BrigadeMoveType
  brigadeId   String
  materialId  String
  qty         Decimal         @db.Decimal(18, 3) // ishorali: berildi (+), sarf/qaytdi (−)
  unitCost    Decimal?        @db.Decimal(18, 2)
  refType     String? // "StockMove" | "BrigadeTask"
  refId       String?
  note        String?
  createdById String
  createdAt   DateTime        @default(now())

  brigade   Brigade  @relation(fields: [brigadeId], references: [id])
  material  Material @relation(fields: [materialId], references: [id])
  createdBy User     @relation("BrigadeMoveBy", fields: [createdById], references: [id])

  @@index([brigadeId, materialId, date])
  @@index([refType, refId])
}

// ───────────────────────── Sotuv: zayavka ─────────────────────────

/// Zayavka kimga: mijozga sotish yoki o'z skladimizga zaxira qilib ishlab chiqarish.
enum OrderKind {
  SALE // mijozga sotish — narx, limit, dastavka, schyot bor
  STOCK // sklad zaxirasi — mijoz yo'q, narx yo'q; tayyor mahsulot hovlida erkin qoldiq bo'lib turadi
}

enum OrderStatus {
  DRAFT // sotuvchi kiritdi
  BLOCKED // kredit limit oshgan — direktor ochishi kerak
  CONFIRMED // ishlab chiqarishga tushdi
  IN_PRODUCTION
  DELIVERED
  CLOSED // to'lov yopildi
  CANCELLED
}

model Order {
  id               String      @id @default(cuid())
  orderNo          String      @unique
  date             DateTime    @default(now())
  customerId       String
  /// SALE — oddiy mijoz zayavkasi; STOCK — sklad zaxirasiga ishlab chiqarish (mijozi — ichki "Sklad" kartochkasi).
  /// STOCK zayavka hech kimga band qilinmaydi: ishlab chiqarilgani hovlida erkin qoldiq bo'ladi.
  kind             OrderKind   @default(SALE)
  status           OrderStatus @default(DRAFT)
  deliveryDate     DateTime
  deliveryTime     String? // "HH:MM" — soat nechida yetkazish kerak (zayavka kirituvchi kiritadi)
  deliveryAddress  String
  // Obyekt nuqtasi — zayavka formasida xaritadan/qidiruvdan belgilanadi.
  // Bo'lmasa: haydovchida navigatsiya ishlamaydi, ETA taxminiy, "yetib bordi" avtomatik belgilanmaydi.
  lat              Float?
  lng              Float?
  /// Obyekt kartasi (Logistika → Obyektlar) — zayavka ochilganda mijoz + manzil bo'yicha topiladi yoki yaratiladi
  siteId           String?
  /// Zavoddan obyektgacha masofa, km — yo'l bo'yicha (OSRM); OSRM javob bermasa to'g'ri chiziq
  distanceKm       Decimal?    @db.Decimal(8, 2)
  /// Masofa qanday olingan: ROUTE — yo'l bo'yicha, LINE — to'g'ri chiziq
  distanceSource   String?
  needsPump        Boolean     @default(false)
  needsDelivery    Boolean     @default(true) // dastavka kerakmi (yo'q bo'lsa mijoz o'zi olib ketadi)
  isUrgent         Boolean     @default(false) // zarur / shoshilinch
  onCredit         Boolean     @default(false) // qarzga — kafolat xati talab qilinadi
  guaranteeAt      DateTime? // mijoz imzolagan kafolat xati qabul qilingan sana
  contractNo       String?     @unique // shartnoma raqami (SH-YYYY-00001) — "Shartnoma qilish" belgilanganda
  contractAmount   Decimal?    @db.Decimal(18, 2) // shartnoma summasi; mahsulot summasi shundan ayiriladi (qoldiq)
  contractAt       DateTime? // shartnoma tuzilgan sana
  contractFile     String? // Didox'da imzolangan shartnoma fayli — uploads/contracts/ ichidagi nomi (isbot uchun tizimga yuklanadi)
  contractFileName String? // foydalanuvchi yuklagan asl fayl nomi
  contractFileType String? // MIME turi (application/pdf, image/jpeg ...)
  contractFileAt   DateTime? // fayl yuklangan vaqt
  note             String?
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer  Customer          @relation(fields: [customerId], references: [id])
  site      Site?             @relation(fields: [siteId], references: [id])
  createdBy User              @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items     OrderItem[]
  batches   ProductionBatch[]
  trips     Trip[]
  invoices  Invoice[]
  tasks     BrigadeTask[]
  payments  Payment[] // oldindan to'lov (avans) — zayavka ochilganda olingan pul

  @@index([deliveryDate])
  @@index([siteId])
  // audit 2026-09-30: qarz/limit, kassa va ro'yxatlar shu ustunlar bo'yicha filtrlaydi
  @@index([customerId])
  @@index([status, date])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  qtyM3     Decimal @db.Decimal(18, 3)
  price     Decimal @db.Decimal(18, 2) // kelishilgan narx (1 m3) — NDS belgilangan bo'lsa soliq qo'shilgan holda
  nds       Boolean @default(false) // narxga "NDS 12%" qo'shilgan (hujjatda alohida qator bo'lib ko'rinadi)
  brigadeId String? // ishlab chiqarish bo'limida tayinlanadi; tasdiqlanganda topshiriq yaratiladi

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
  brigade Brigade?     @relation(fields: [brigadeId], references: [id])
  task    BrigadeTask?

  // audit 2026-09-30: qarz/limit, kassa va ro'yxatlar shu ustunlar bo'yicha filtrlaydi
  @@index([orderId])
  @@index([productId])
}

// ───────────────────────── Brigadalar va topshiriqlar ─────────────────────────

model Brigade {
  id        String   @id @default(cuid())
  name      String
  leaderId  String? // brigadir (Employee)
  phone     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  leader     Employee?       @relation("BrigadeLeader", fields: [leaderId], references: [id])
  members    Employee[]      @relation("BrigadeMembers")
  items      OrderItem[]
  tasks      BrigadeTask[]
  moves      BrigadeMove[]
  stockMoves StockMove[]
  defects    ProductDefect[]
  shifts     BrigadeShift[]
  issues     BrigadeIssue[]
}

enum TaskStatus {
  NEW // yuborildi
  IN_PROGRESS // qisman bajarildi
  DONE // to'liq bajarildi
  CANCELLED
}

/// Zayavka qatori brigadaga topshiriq sifatida yuboriladi. qoldiq = qty − doneQty.
model BrigadeTask {
  id          String     @id @default(cuid())
  taskNo      String     @unique
  orderId     String
  orderItemId String     @unique
  brigadeId   String
  qty         Decimal    @db.Decimal(18, 3)
  doneQty     Decimal    @default(0) @db.Decimal(18, 3)
  status      TaskStatus @default(NEW)
  dueDate     DateTime
  note        String?
  /// Brigadir "Ishni boshlash" bosgan vaqt — NEW holatda "Jarayonda" ni "Brigadaga berildi" dan ajratadi.
  startedAt   DateTime?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  order     Order           @relation(fields: [orderId], references: [id])
  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  brigade   Brigade         @relation(fields: [brigadeId], references: [id])
  createdBy User            @relation("TaskCreatedBy", fields: [createdById], references: [id])
  progress  TaskProgress[]
  issues    BrigadeIssue[]
  defects   ProductDefect[]

  @@index([brigadeId, status])
  @@index([orderId])
}

/// Brigada smenasi — brigadir ilovada ochadi va yopadi (kuniga bitta). Yopilganda yakuniy hisobot
/// muzlatiladi (`report` — `lib/brigade-shift.ts` ShiftReport) va ishlab chiqarishga yuboriladi.
model BrigadeShift {
  id         String    @id @default(cuid())
  brigadeId  String
  date       DateTime  @db.Date
  openedAt   DateTime  @default(now())
  openedById String
  closedAt   DateTime?
  closedById String?
  report     Json?
  summary    String? // bir qatorli xulosa — ro'yxat va bildirishnoma uchun
  note       String? // brigadir izohi
  seenAt     DateTime? // ishlab chiqarish birinchi ochgan vaqt

  brigade  Brigade @relation(fields: [brigadeId], references: [id])
  openedBy User    @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy User?   @relation("ShiftClosedBy", fields: [closedById], references: [id])

  @@unique([brigadeId, date])
  @@index([date])
}

enum BrigadeIssueKind {
  DELAY // kechikish
  EQUIPMENT // uskuna nosozligi
  MATERIAL // material yetishmasligi
  STAFF // xodim yetishmasligi / qo'shimcha ishchi
  QUALITY // sifat muammosi
  OTHER
}

/// Brigadir bildirgan muammo. Mas'ul bo'lim (`ISSUE_OWNER`) hal qiladi; ochiq MATERIAL/EQUIPMENT/QUALITY
/// muammosi topshiriqqa bog'langan bo'lsa, topshiriq holati "Material yetishmaydi" kabi ko'rinadi.
model BrigadeIssue {
  id           String           @id @default(cuid())
  brigadeId    String
  taskId       String?
  kind         BrigadeIssueKind
  equipment    String? // uskuna nomi (EQUIPMENT)
  qty          Decimal?         @db.Decimal(18, 3) // kerakli ishchi soni (STAFF) yoki material miqdori
  downtimeMin  Int? // to'xtab qolgan vaqt, daqiqa
  note         String
  createdById  String
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?

  brigade    Brigade      @relation(fields: [brigadeId], references: [id])
  task       BrigadeTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy  User         @relation("BrigadeIssueBy", fields: [createdById], references: [id])
  resolvedBy User?        @relation("BrigadeIssueResolvedBy", fields: [resolvedById], references: [id])

  @@index([brigadeId, createdAt])
  @@index([resolvedAt])
}

/// Bajarilganlik qaydi: kim, qachon, qancha.
model TaskProgress {
  id          String   @id @default(cuid())
  taskId      String
  qty         Decimal  @db.Decimal(18, 3)
  date        DateTime @default(now())
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  task      BrigadeTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  createdBy User        @relation("ProgressCreatedBy", fields: [createdById], references: [id])

  @@index([taskId])
}

// ───────────────────────── Ishlab chiqarish: zames ─────────────────────────

/// Bitta zames (partiya). Saqlanganda retsept bo'yicha xomashyo
/// PRODUCTION_CONSUME sifatida StockMove'ga yoziladi.
model ProductionBatch {
  id            String    @id @default(cuid())
  batchNo       String    @unique
  date          DateTime  @default(now())
  shift         Int       @default(1)
  orderId       String?
  productId     String
  recipeId      String
  qtyM3         Decimal   @db.Decimal(18, 3)
  note          String?
  createdById   String
  createdAt     DateTime  @default(now())
  /// Storno: zames bekor qilingan (xomashyo qaytgan, mahsulot chiqarilgan) — kim, qachon, nima sababdan
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  order     Order?  @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  recipe    Recipe  @relation(fields: [recipeId], references: [id])
  createdBy User    @relation("BatchCreatedBy", fields: [createdById], references: [id])

  @@index([orderId])
}

/// Ishlab chiqarish plani — direktor mahsulot bo'yicha oyga belgilaydi (plita, ustun, beton...).
/// Kunlik plan bo'sh bo'lsa oylik plan ish kunlariga (yakshanbasiz) bo'linadi.
/// Fakt saqlanmaydi: PRODUCTION_OUTPUT (StockMove) yig'indisidan hisoblanadi.
model ProductionPlan {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  productId String
  monthQty  Decimal  @db.Decimal(18, 3)
  dayQty    Decimal? @db.Decimal(18, 3)
  note      String?
  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  setBy   User    @relation("PlanSetBy", fields: [setById], references: [id])

  @@unique([year, month, productId])
}

/// Xarajat byudjeti — direktor har kategoriya (Kirim-Chiqim kategoriyalari) uchun oyga belgilaydi.
/// Fakt saqlanmaydi: CashTransaction EXPENSE yig'indisi. Limit bo'sh bo'lsa byudjetning o'zi limit.
model ExpenseBudget {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  category  String
  amount    Decimal  @db.Decimal(18, 2)
  limit     Decimal? @db.Decimal(18, 2) // shu summadan oshsa — kritik (bo'sh: amount × kritik foiz)
  note      String?
  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setBy User @relation("BudgetSetBy", fields: [setById], references: [id])

  @@unique([year, month, category])
}

/// Tayyor mahsulot braki. Saqlanganda hovli qoldig'idan WRITE_OFF (StockMove, refType "ProductDefect")
/// bilan ayriladi — o'chirilsa o'sha harakat ham o'chadi.
model ProductDefect {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  productId   String
  brigadeId   String?
  /// Qaysi topshiriqdan chiqqan brak (brigadir topshiriq kartasida yoki fakt bilan birga belgilaydi).
  taskId      String?
  qty         Decimal  @db.Decimal(18, 3)
  reason      String
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  product   Product      @relation(fields: [productId], references: [id])
  brigade   Brigade?     @relation(fields: [brigadeId], references: [id])
  task      BrigadeTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy User         @relation("DefectCreatedBy", fields: [createdById], references: [id])

  @@index([date])
  @@index([taskId])
}

/// Ishlab chiqarishning kunlik hisoboti — sex "Qayd etish" bosganda o'sha paytdagi raqamlar
/// muzlatib saqlanadi (`data` — `lib/production-report.ts` ReportSnapshot). Yozuv o'zgartirilmaydi:
/// kun ichida qayta qayd etilsa yangi nusxa qo'shiladi, hammasi tarixda qoladi. Direktor kabinetida ko'rinadi.
model ProductionReport {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date // hisobot kuni
  data        Json
  summary     String // bir qatorli xulosa — ro'yxat va bildirishnoma uchun
  note        String? // sex boshlig'i izohi
  createdById String
  createdAt   DateTime  @default(now())
  seenAt      DateTime? // direktor birinchi marta ochgan vaqt
  seenById    String?

  createdBy User @relation("ProdReportBy", fields: [createdById], references: [id])

  @@index([date])
}

// ───────────────────────── Logistika: reys / nakladnoy ─────────────────────────

enum TripStatus {
  PLANNED
  LOADED
  ON_ROAD
  DELIVERED
  CANCELLED
}

model Trip {
  id             String     @id @default(cuid())
  deliveryNoteNo String     @unique // nakladnoy raqami (QR shu bo'yicha)
  orderId        String
  vehicleId      String
  driverId       String
  qtyM3          Decimal    @db.Decimal(18, 3)
  status         TripStatus @default(PLANNED)
  loadedAt       DateTime?
  deliveredAt    DateTime?
  receiverName   String? // obyektda kim qabul qildi
  note           String?
  createdAt      DateTime   @default(now())

  // ── Yukni olgan joyi (zavod/sklad) — logistika "Yuklandi" bosqichida belgilaydi ──
  pickupAddress String? // yuk olingan joy manzili
  pickupLat     Float? // xaritadagi nuqta — haydovchi ilovasida marshrut shu yerdan boshlanadi
  pickupLng     Float?

  // ── Insof ECO (haydovchi ilovasi) bilan sinxron ──
  ecoDeliveryId String?   @unique // ECO Delivery.id
  ecoStatus     String? // ECO holati: ASSIGNED, ACCEPTED, LOADING, EN_ROUTE, ARRIVED, UNLOADING, COMPLETED, DECLINED, FAILED, DISPUTED, CANCELLED
  ecoSyncedAt   DateTime? // oxirgi muvaffaqiyatli yuborish/qabul
  ecoError      String? // oxirgi xato (ko'rsatiladi, keyingi muvaffaqiyatda tozalanadi)

  // ── Reys bosqichlari vaqti (Logistika TZ) ──
  // Holat (status) o'zgarmaydi: "Obyektga keldi", "Tushirilmoqda", "Yopildi" — ON_ROAD/DELIVERED
  // ichidagi bosqichlar, ular shu vaqtlardan chiqariladi (`tripPhase`, lib/logistics.ts).
  plannedAt   DateTime? // rejadagi yetkazish vaqti (dispetcher kalendari; bo'lmasa zayavka sanasi+soati)
  departedAt  DateTime? // yo'lga chiqdi
  arrivedAt   DateTime? // obyektga yetib keldi
  unloadingAt DateTime? // tushirish boshlandi
  returnedAt  DateTime? // zavodga qaytdi — aylanish vaqti shu bilan yopiladi
  closedAt    DateTime? // reys yopildi (qabul tasdiqlandi, xarajatlar kiritildi)
  closedById  String?

  // ── Yetkazib berish (Delivery) ──
  acceptedQty     Decimal? @db.Decimal(18, 3) // mijoz qabul qilgan miqdor (bo'lmasa = qtyM3)
  returnedQty     Decimal? @db.Decimal(18, 3) // qaytarilgan miqdor (ortiqcha / sifat)
  deliveryComment String? // yetkazishdagi izoh

  /// Ochiq /verify sahifasi uchun tasodifiy kalit (QR havolasida `?k=`): nakladnoy raqami ketma-ket —
  /// kalitsiz raqamlarni terib butun mijozlar ro'yxatini yig'ib bo'lmasin. Eski reyslarda bo'sh.
  verifyToken String? @unique

  order     Order              @relation(fields: [orderId], references: [id])
  vehicle   Vehicle            @relation(fields: [vehicleId], references: [id])
  driver    Employee           @relation("TripDriver", fields: [driverId], references: [id])
  positions TripPosition[]
  issues    TripIssue[]
  fuelLogs  FuelLog[]
  expenses  TransportExpense[]

  @@index([status, createdAt])
  // audit 2026-09-30: qarz/limit, kassa va ro'yxatlar shu ustunlar bo'yicha filtrlaydi
  @@index([orderId])
  @@index([vehicleId])
  @@index([driverId])
}

/// Reysdagi muammo — haydovchi ilovadan, dispetcher vebdan yoki ECO (rad etish, e'tiroz) yozadi.
/// Ochiq muammo bo'lsa zayavka logistikada "Muammo mavjud" bo'lib ko'rinadi.
model TripIssue {
  id           String        @id @default(cuid())
  tripId       String
  kind         TripIssueKind
  note         String?
  source       String        @default("LOGISTICS") // DRIVER | LOGISTICS | ECO
  createdById  String
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String? // qanday hal qilindi

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([resolvedAt])
}

enum TripIssueKind {
  BREAKDOWN // mashina buzildi
  TRAFFIC // tirbandlik / yo'l yopiq
  SITE_NOT_READY // obyekt tayyor emas (qabul qiluvchi yo'q, joy yo'q)
  QUALITY // sifat / hajm bo'yicha e'tiroz
  ACCIDENT // YTH
  DECLINED // haydovchi reysni rad etdi
  OTHER
}

/// Obyekt — mijozning qurilish maydoni. Bir mijozda bir nechta obyekt bo'ladi.
/// Kontakt, qabul vaqti va maxsus ko'rsatma haydovchiga reys kartasida ko'rinadi.
model AiChat {
  id        String      @id @default(cuid())
  userId    String
  title     String      @default("Yangi suhbat")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation("AiChatUser", fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Site {
  id            String   @id @default(cuid())
  customerId    String
  name          String
  address       String
  lat           Float?
  lng           Float?
  contactName   String?
  contactPhone  String?
  deliveryHours String? // qabul qilish vaqti: "08:00–18:00"
  instructions  String? // maxsus ko'rsatma: kirish darvozasi, nasos joyi, yo'l cheklovi...
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([customerId])
}

/// Zapravka — yoqilg'i quyilgani. Haydovchi ilovadan yoki logistika vebdan kiritadi.
model FuelLog {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  vehicleId   String
  driverId    String?
  tripId      String?
  fuelType    FuelType
  liters      Decimal  @db.Decimal(10, 2)
  pricePerL   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(18, 2) // liters × pricePerL
  odometerKm  Int?
  station     String? // zapravka nomi
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  vehicle Vehicle   @relation(fields: [vehicleId], references: [id])
  driver  Employee? @relation(fields: [driverId], references: [id])
  trip    Trip?     @relation(fields: [tripId], references: [id])

  @@index([date])
  @@index([vehicleId, date])
  @@index([tripId])
}

/// Transport xarajati (yoqilg'idan tashqari): haydovchi haqi, yo'l, ta'mir, jarima...
/// Pul harakati emas — logistika tannarxi. Kassadan to'lov Kirim-Chiqimda alohida yuritiladi.
model TransportExpense {
  id          String               @id @default(cuid())
  date        DateTime             @default(now())
  kind        TransportExpenseKind
  vehicleId   String?
  driverId    String?
  tripId      String?
  amount      Decimal              @db.Decimal(18, 2)
  note        String?
  createdById String
  createdAt   DateTime             @default(now())

  vehicle Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver  Employee? @relation(fields: [driverId], references: [id])
  trip    Trip?     @relation(fields: [tripId], references: [id])

  @@index([date])
  @@index([tripId])
}

enum TransportExpenseKind {
  DRIVER_PAY // haydovchi haqi (reys uchun)
  ROAD // yo'l, ko'prik, kirish to'lovi
  REPAIR // ta'mirlash
  PARTS // ehtiyot qism, shina, moy
  PARKING // turargoh
  FINE // jarima
  WASH // yuvish
  OTHER
}

/// Reys davomida haydovchi ilovasidan kelgan GPS nuqtalari.
///
/// Nega ECO'da emas: ECO'ning izi `tracking/gps` orqali ECO foydalanuvchisiga bog'lanadi,
/// zavod haydovchisi esa ERP logini bilan kiradi va ECO hisobiga ega emas. Tashqi
/// pudratchi haydovchilarining izi avvalgidek ECO'da qoladi — xarita ikkalasini qo'shib ko'rsatadi.
model TripPosition {
  id        String   @id @default(cuid())
  tripId    String
  lat       Float
  lng       Float
  speedKmh  Float?
  heading   Float?
  /// Qurilmadagi vaqt — nuqtalar aloqa uzilganda buferda turib, keyin to'p-to'p keladi
  at        DateTime
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, at])
}

// ───────────────────────── Moliya: schyot / to'lov / kassa ─────────────────────────

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

model Invoice {
  id         String        @id @default(cuid())
  invoiceNo  String        @unique
  date       DateTime      @default(now())
  customerId String
  orderId    String?
  amount     Decimal       @db.Decimal(18, 2)
  status     InvoiceStatus @default(OPEN)
  /// Boshlang'ich qoldiq (tizimga o'tish sanasidagi mijoz qarzi/avansi) — zayavkasiz "schyot".
  /// Musbat — mijoz qarzi (OPEN, to'lov shunga bog'lanadi); manfiy — mijoz avansi (PAID, qarzdan ayiriladi).
  /// Qarz/akt sverka hisoblarida oddiy schyotdek qatnashadi, sotuv (tushum) hisobotlariga kirmaydi.
  isOpening  Boolean       @default(false)
  createdAt  DateTime      @default(now())

  customer Customer        @relation(fields: [customerId], references: [id])
  order    Order?          @relation(fields: [orderId], references: [id])
  payments Payment[]
  opening  OpeningBalance?

  // audit 2026-09-30: qarz/limit, kassa va ro'yxatlar shu ustunlar bo'yicha filtrlaydi
  @@index([customerId, status])
  @@index([orderId])
}

enum CashAccountType {
  CASH
  BANK
}

model CashAccount {
  id       String          @id @default(cuid())
  name     String
  type     CashAccountType
  isActive Boolean         @default(true)

  payments       Payment[]
  transactions   CashTransaction[]
  supplyRequests SupplyRequest[]
  register       SalesRegister[]
  openings       OpeningBalance[]

  // Bir xil nomli hisob ikki marta ochilmasin (seed qayta ishga tushsa ham)
  @@unique([name, type])
}

enum CashTxType {
  INCOME // kirim (mijoz to'lovidan tashqari: boshqa tushumlar)
  EXPENSE // chiqim
  /// Boshlang'ich qoldiq: hisob qoldig'iga qo'shiladi (summa ishorali, manfiy — overdraft),
  /// lekin kirim/chiqim (P&L, pul oqimi) hisobotlariga kirmaydi. Faqat "Boshlang'ich qoldiqlar" bo'limi yozadi.
  OPENING
}

/// Kirim-Chiqim jurnali. Mijoz to'lovlari Payment'da — bu yerda boshqa kirim va barcha chiqimlar.
model CashTransaction {
  id            String     @id @default(cuid())
  date          DateTime   @default(now())
  type          CashTxType
  cashAccountId String
  amount        Decimal    @db.Decimal(18, 2)
  category      String // "Xomashyo", "Ish haqi", "Transport", ...
  counterparty  String? // kimga / kimdan
  supplierId    String?
  note          String?
  refType       String? // qaysi hujjatdan avtomatik yozilgan: "GoodsReceipt" | "StockIn"
  refId         String? // shu hujjat id'si — Kirim-Chiqimdan batafsilga o'tish uchun
  createdById   String
  createdAt     DateTime   @default(now())

  cashAccount CashAccount     @relation(fields: [cashAccountId], references: [id])
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  createdBy   User            @relation("CashTxCreatedBy", fields: [createdById], references: [id])
  opening     OpeningBalance?

  @@index([date, type])
  // audit 2026-09-30: qarz/limit, kassa va ro'yxatlar shu ustunlar bo'yicha filtrlaydi
  @@index([cashAccountId])
  @@index([refType, refId])
  @@index([supplierId])
}

enum OpeningKind {
  CUSTOMER // mijoz qarzi (+) yoki avansi (−)
  SUPPLIER // yetkazuvchiga qarzimiz (+) yoki unga bergan avansimiz (−)
  CASH // kassa / bank hisobi qoldig'i
  STOCK // tayyor mahsulot qoldig'i (sklad bo'yicha)
}

/// Boshlang'ich qoldiq — tizimga o'tish sanasidagi holat (real korxona ma'lumotini kiritish).
/// Har yozuv o'z hujjatini yaratadi va undan o'tib hamma hisobotga tushadi:
///   CUSTOMER → Invoice (isOpening), CASH → CashTransaction (OPENING), STOCK → StockMove (ADJUSTMENT, refType "OpeningBalance"),
///   SUPPLIER → alohida hujjat yo'q: yetkazuvchi qarzi shu yozuvdan, to'lovi — CashTransaction (refType "OpeningBalance").
/// Bitta obyektga bitta faol qoldiq (`activeKey` unique); bekor qilinsa kalit bo'shaydi. Tahrir/bekor — faqat direktor.
model OpeningBalance {
  id            String      @id @default(cuid())
  kind          OpeningKind
  date          DateTime // qoldiq qaysi sana holatiga (tizimga o'tish sanasi)
  customerId    String?
  supplierId    String?
  cashAccountId String?
  productId     String?
  warehouseId   String?
  amount        Decimal     @db.Decimal(18, 2) // pul (ishorali); STOCK da = qty × unitCost
  qty           Decimal?    @db.Decimal(18, 3) // STOCK: miqdor
  unitCost      Decimal?    @db.Decimal(18, 2) // STOCK: birlik tannarxi
  note          String?
  /// "CUSTOMER:<id>", "STOCK:<productId>:<warehouseId>"... — faol yozuvda to'ldiriladi, bekor qilinganda null
  activeKey     String?     @unique
  invoiceId     String?     @unique
  cashTxId      String?     @unique
  stockMoveId   String?     @unique
  createdById   String
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  cashAccount CashAccount?     @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  product     Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  cashTx      CashTransaction? @relation(fields: [cashTxId], references: [id], onDelete: Restrict)
  stockMove   StockMove?       @relation(fields: [stockMoveId], references: [id], onDelete: Restrict)

  @@index([kind, cancelledAt])
}

model Payment {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  customerId    String
  invoiceId     String?
  orderId       String? // avans: zayavka ochilganda olingan pul; schyot yozilganda unga bog'lanadi
  cashAccountId String
  amount        Decimal  @db.Decimal(18, 2)
  note          String?
  createdAt     DateTime @default(now())
  /// Pulni kim qabul qildi/kiritdi (kassir, buxgalter; eski yozuvlarda bo'sh)
  createdById   String?

  customer    Customer       @relation(fields: [customerId], references: [id])
  createdBy   User?          @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id])
  order       Order?         @relation(fields: [orderId], references: [id])
  cashAccount CashAccount    @relation(fields: [cashAccountId], references: [id])
  register    SalesRegister?

  @@index([orderId])
  // audit 2026-09-30: qarz/limit, kassa va ro'yxatlar shu ustunlar bo'yicha filtrlaydi
  @@index([customerId])
  @@index([invoiceId])
  @@index([date])
  @@index([cashAccountId])
}

/// Realizatsiya jurnali — buxgalteriya Excel'da yuritadigan kunlik jo'natma jadvali
/// (Число, № маш, Наименование, ТТН, К-во, Кому, Цена, НДС, Итого Сумма...).
/// Kassa/bank sahifasiga Excel orqali yuklanadi: har qator o'z holicha saqlanadi va
/// "Деньги" ustuniga qarab pul naqd kassaga (н-к) yoki bank hisobiga (п-р) Payment sifatida tushadi.
/// Mijoz bo'yicha ko'rish: /payments/mijoz/<customerId>.
model SalesRegister {
  id            String   @id @default(cuid())
  date          DateTime // "Число"
  customerId    String // "Кому"
  vehicleNo     String? // "№ маш" — mashina raqami (matn; texnika ro'yxatiga bog'lanmaydi)
  ttn           String? // "ТТН" — nakladnoy raqami
  productName   String // "Наименование": Beton M250, PK 61-10-8 ...
  unit          String   @default("m3") // "Ед Изм"
  qty           Decimal  @db.Decimal(18, 3) // "К-во"
  fromWho       String? // "От Кого" — ИНСОФ
  payType       String? // "Деньги": п-р (o'tkazma) | н-к (naqd)
  deliveryFee   Decimal  @default(0) @db.Decimal(18, 2) // "Доставка"
  price         Decimal  @default(0) @db.Decimal(18, 2) // "Цена"
  sum           Decimal  @default(0) @db.Decimal(18, 2) // "Общие Сумма"
  nds           Decimal  @default(0) @db.Decimal(18, 2) // "НДС 12%"
  total         Decimal  @default(0) @db.Decimal(18, 2) // "Итого Сумма" — kassaga tushadigan summa
  address       String? // "Адрес"
  contractNo    String? // "Договор Номер"
  invoiceNo     String? // "Счёт Фактура"
  monthNo       String? // "Ой"
  note          String? // "Изох"
  cashAccountId String? // qaysi kassa/hisobga yozildi
  paymentId     String?  @unique // shu qatordan yozilgan kassa kirimi (o'chirilsa birga o'chadi)
  batch         String // bitta import partiyasi — jurnalda guruhlanadi va butunlay o'chiriladi
  createdById   String
  createdAt     DateTime @default(now())

  customer    Customer     @relation(fields: [customerId], references: [id])
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
  payment     Payment?     @relation(fields: [paymentId], references: [id])
  createdBy   User         @relation("SalesRegisterCreatedBy", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([date])
  @@index([batch])
}

// ───────────────────────── Audit ─────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // CREATE | UPDATE | DELETE | STATUS_CHANGE
  entity    String // "Order", "StockMove" ...
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}

// ───────────────────────── BI: reja va marketing ─────────────────────────

/// Oylik sotuv rejasi. sellerId = null — butun zavod rejasi; sellerId — sotuvchi (User) rejasi.
model SalesPlan {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  sellerId  String?
  amount    Decimal  @db.Decimal(18, 2)
  volumeM3  Decimal? @db.Decimal(18, 3)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, sellerId])
  @@index([year, month])
}

enum MarketingEntryKind {
  BUDGET // ajratilgan pul
  PLAN // natija maqsadlari
  FACT // to'langan xarajat va natija
}

/// Marketing ma'lumotlari: oy × kanal × tur (byudjet / reja / fakt).
model MarketingEntry {
  id          String             @id @default(cuid())
  year        Int
  month       Int
  kind        MarketingEntryKind
  channel     String
  amount      Decimal            @db.Decimal(18, 2)
  leads       Int?
  customers   Int?
  revenue     Decimal?           @db.Decimal(18, 2)
  impressions Int?
  clicks      Int?
  note        String?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy User @relation("MarketingCreatedBy", fields: [createdById], references: [id])

  @@index([year, month])
}

// ───────────────────────── Telegram bot ─────────────────────────

/// Botga yozayotgan Telegram chat. userId bo'lsa — ERP foydalanuvchisiga bog'langan (faqat shunda javob beriladi).
model TelegramAccount {
  id        String    @id @default(cuid())
  chatId    String    @unique // Telegram chat id (shaxsiy yozishma)
  userId    String?
  username  String?
  firstName String?
  isBlocked Boolean   @default(false) // direktor uzib qo'ysa
  linkedAt  DateTime?
  lastSeen  DateTime  @default(now())
  createdAt DateTime  @default(now())

  user     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TelegramMessage[]

  @@index([userId])
}

/// Bir martalik ulash kodi. Sozlamalar → Telegram bot'da yaratiladi, botga yuboriladi.
model TelegramLinkCode {
  code      String    @id // 6 xonali
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Bot orqali kelgan savol va javob — audit va suhbat konteksti uchun.
model TelegramMessage {
  id        String   @id @default(cuid())
  accountId String
  kind      String // voice | text
  question  String // ovoz bo'lsa — matnga aylantirilgani
  answer    String
  level     Int      @default(0) // 0 — qoida, 2 — Claude
  latencyMs Int?
  createdAt DateTime @default(now())

  account TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

/// AI agent tayyorlagan amal (zayavka ochish, to'lov qabul qilish…) — bazaga yozishdan
/// oldin foydalanuvchi tasdig'ini kutadi. Tasdiqlangach `actions.ts` uni bajaradi.
/// Argumentlar tayyorlash bosqichida tekshirilgan va id'larga keltirilgan holda saqlanadi.
model AiAction {
  id        String    @id @default(cuid())
  userId    String? // foydalanuvchi o'chirilsa tarix qoladi (SetNull)
  kind      String // order_create, payment_add, …
  args      Json // tekshirilgan, id'larga keltirilgan argumentlar
  summary   String // foydalanuvchiga ko'rsatiladigan tasdiq matni
  warnings  String? // ogohlantirishlar (qatorma-qator)
  status    String    @default("PENDING") // PENDING | DONE | CANCELLED | FAILED
  source    String // telegram | panel
  chatId    String? // Telegram chat (tugma bosilganda kimga javob berish)
  result    String? // bajarilgandan keyingi natija yoki xato matni
  createdAt DateTime  @default(now())
  expiresAt DateTime
  doneAt    DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
}

// ───────────────────────── SMS (Eskiz) ─────────────────────────

/// Yuborilgan har bir SMS. Ikki vazifasi bor: xarajat nazorati (oyiga nechta ketdi)
/// va "yubordikmi?" savoliga javob. `text` da parol/kod MASKALANGAN holda yoziladi —
/// jurnalni ko'rgan odam begona parolni o'qiy olmasin.
model SmsLog {
  id        String   @id @default(cuid())
  phone     String // +998XXXXXXXXX ko'rinishida normallashtirilgan
  template  String // shablon kaliti: login_granted, password_changed, reset_code
  text      String // yuborilgan matn, maxfiy qismi ••• bilan almashtirilgan
  status    String // SENT | FAILED | SKIPPED
  provider  String // eskiz | fake
  error     String? // FAILED bo'lsa sabab
  userId    String? // kimga tegishli (bo'lsa)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([createdAt])
}

/// Parolni tiklash uchun bir martalik SMS kodi (`/login/reset`).
/// Kodning o'zi saqlanmaydi — faqat bcrypt xeshi. Muddati va urinishlar soni cheklangan.
model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  phone     String // kod yuborilgan raqam (normallashtirilgan)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([phone, createdAt])
}

enum LeadStatus {
  NEW // hali hech kim ko'tarmagan
  IN_PROGRESS // sotuv bog'landi, kelishilmoqda
  CONVERTED // mijozga aylandi
  REJECTED // bekor — qiziqmadi, mos kelmadi
}

/// Saytdagi "Ariza qoldirish" formasidan tushgan so'rov (`/` landing sahifasi).
/// Mijoz bazasiga darhol yozilmaydi: sotuv bo'limi bog'lanib, kerak bo'lsa
/// `/leads` sahifasidan bitta tugma bilan `Customer` ga aylantiradi.
model Lead {
  id          String     @id @default(cuid())
  name        String
  phone       String // normallashtirilgan: +998XXXXXXXXX
  productId   String? // saytdagi ro'yxatdan tanlangan mahsulot
  qty         Decimal?   @db.Decimal(18, 3) // taxminiy hajm (mahsulot birligida)
  address     String? // obyekt manzili
  message     String?
  source      String     @default("landing") // keyinchalik: telegram, instagram…
  status      LeadStatus @default(NEW)
  note        String? // sotuvchining ichki izohi
  customerId  String? // CONVERTED bo'lganda — yaratilgan/topilgan mijoz
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime   @default(now())

  product   Product?  @relation(fields: [productId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  handledBy User?     @relation("LeadHandledBy", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@index([phone])
  @@index([customerId])
}

enum DeletionRequestSource {
  APP // ERP logini bilan kirgan xodim ilovadan so'radi
  ECO // ECO haydovchisi ilovadan so'radi (webhook `driver.delete_requested`)
  WEB // saytdagi /maxfiylik/hisobni-ochirish formasi (ilovasiz)
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Hisobni o'chirish so'rovi (App Store / Google Play talabi). Mijoz ilovada o'zi darhol
/// o'chiradi (ECO tomonida); zavod xodimi so'rov qoldiradi — direktor Sozlamalar sahifasida
/// tasdiqlaydi: ERP logini yopiladi, sessiyalar kuyadi, qurilma/bildirishnoma yozuvlari
/// o'chadi, ECO haydovchisi bo'lsa ECO ham anonimlashtiradi. Xodim kartasi (HR) qoladi.
model AccountDeletionRequest {
  id          String                @id @default(cuid())
  source      DeletionRequestSource
  status      DeletionRequestStatus @default(PENDING)
  userId      String? // ERP foydalanuvchisi (APP yoki telefon bo'yicha topilgan)
  employeeId  String? // bog'liq xodim kartasi
  ecoUserId   String? // ECO foydalanuvchi id (ECO manbasi)
  fullName    String
  phone       String? // normallashtirilgan
  note        String?
  handledById String?
  handledAt   DateTime?
  result      String? // tasdiqda nima qilindi (ERP logini yopildi, ECO anonim...)
  createdAt   DateTime              @default(now())

  user      User?     @relation("DeletionRequestUser", fields: [userId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id])
  handledBy User?     @relation("DeletionRequestHandledBy", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@index([phone])
}

// ───────────────────────── Bildirishnomalar ─────────────────────────

/// Xodimning mobil qurilmasi — push xabar shu manzilga boradi.
///
/// Bitta xodimda bir nechta qurilma bo'lishi mumkin (telefon + planshet), shuning uchun
/// yozuv `deviceId` bo'yicha yangilanadi: ilova qayta o'rnatilganda Expo tokeni almashadi,
/// qurilma esa o'sha-o'sha — aks holda har o'rnatishda yangi qator qo'shilib, bitta
/// telefonga bir nechta nusxa yuborilardi.
model MobileDevice {
  id            String   @id @default(cuid())
  userId        String
  deviceId      String /// ilova bergan barqaror qurilma id
  expoPushToken String
  platform      String? /// ios / android
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

/// Ilovadagi bildirishnoma ro'yxati.
///
/// Push yetib bormasligi mumkin (telefon o'chiq, ruxsat berilmagan, Expo xizmati javob
/// bermadi) — xabar shu yerda qoladi va xodim ilovani ochganda ko'radi. Ya'ni push
/// "darhol xabar berish" vositasi, manba esa shu jadval.
model Notification {
  id        String    @id @default(cuid())
  userId    String? // foydalanuvchi o'chirilsa bildirishnoma tarixi qoladi (SetNull)
  type      String /// TRIP_ASSIGNED, ORDER_BLOCKED… — ikonka va guruhlash uchun
  title     String
  body      String
  /// Bosilganda ochiladigan kartochka: {"key":"trips","id":"..."}
  link      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum AccessRequestStatus {
  UNVERIFIED // telefon kodi hali tasdiqlanmagan — HR'ga ko'rinmaydi
  PENDING // telefon tasdiqlandi, HR/direktor qarorini kutmoqda
  APPROVED // login ochildi
  REJECTED // rad etildi
}

/// Kirish sahifasidagi "Ro'yxatdan o'tish" arizasi (`/login/register`).
/// Xodim o'zi login/parol tanlaydi, telefonini kod bilan tasdiqlaydi; login FAQAT Otdel kadr yoki
/// direktor tasdiqlagach ochiladi. Parolning faqat bcrypt xeshi saqlanadi.
model AccessRequest {
  id            String              @id @default(cuid())
  fullName      String
  phone         String // normallashtirilgan: +998XXXXXXXXX
  position      String // so'ralgan bo'lim (POSITIONS label)
  login         String // tanlangan login (kichik harfda)
  passwordHash  String
  note          String?
  status        AccessRequestStatus @default(UNVERIFIED)
  codeHash      String?
  codeExpiresAt DateTime?
  attempts      Int                 @default(0)
  verifiedAt    DateTime?
  decidedById   String?
  decidedAt     DateTime?
  rejectReason  String?
  userId        String? // APPROVED bo'lganda ochilgan login
  ip            String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}
