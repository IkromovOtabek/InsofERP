// Insof — markaziy boshqaruv (control) bazasi.
//
// Ko'p korxonali tuzilma: har korxona (tenant) o'z Postgres bazasida, shu kodning alohida
// jarayonida ishlaydi (zavod2.insof.uz → 127.0.0.1:3101 → insof_t_zavod2). Bu baza esa faqat
// korxonalar ro'yxati, IT superadminlar, ular qilgan amallar va kunlik statistika suratlarini saqlaydi.
// Korxona ma'lumotlari (zayavka, mijoz, pul) bu yerga HECH QACHON yozilmaydi.
//
// Migratsiya: npx prisma migrate deploy --schema prisma/control/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/control"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

enum TenantStatus {
  PROVISIONING // baza yaratildi, jarayon hali ishga tushirilmagan
  ACTIVE
  SUSPENDED // superadmin to'xtatgan: xodimlar kira olmaydi, ma'lumot saqlanadi
  ARCHIVED // shartnoma tugagan — faqat zaxira nusxa uchun
}

/// IT xodimi (superadmin) — barcha korxonalarni kuzatadi, yaratadi, direktorga login beradi.
model SuperAdmin {
  id             String    @id @default(cuid())
  login          String    @unique
  passwordHash   String
  fullName       String
  isActive       Boolean   @default(true)
  /// Parol almashsa yoki hisob yopilsa eski cookie'lar kuyadi
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  /// Insof ECO ilovasi hisobi (ECO User.id) — telefon + ilova paroli bilan panelga kirish. Bo'sh — ulanmagan.
  /// Faqat admin O'ZI (joriy panel paroli bilan) ulaydi; bitta ECO hisobi — bitta admin.
  ecoUserId      String?   @unique
  /// Ulangan telefon — faqat ko'rsatish uchun, maskalangan (+998 90 *** ** 67)
  ecoPhone       String?
  /// Panel ko'rinishi (faqat admin o'zi o'zgartiradi): { mobileLayout: "widgets"|"pro", colorMode: "system"|"light"|"dark" }.
  /// Tuzilma src/lib/control/ui-prefs.ts dagi zod sxemasi bilan tekshiriladi; bo'sh — standart.
  uiPrefs        Json?

  events ControlEvent[]
}

/// Korxona — alohida baza + alohida jarayon (port) + o'z subdomeni.
model Tenant {
  id            String       @id @default(cuid())
  /// Lotin kichik harf, raqam, chiziqcha: subdomen va baza nomi shundan ("zavod2" → insof_t_zavod2)
  slug          String       @unique
  name          String
  /// Brauzerdagi manzil (zavod2.insof.uz). Bo'sh — hali domen ulanmagan.
  domain        String?      @unique
  /// Server ichidagi manzil — statistika va SSO shu orqali (http://127.0.0.1:3101)
  internalUrl   String
  port          Int          @unique
  dbName        String       @unique
  status        TenantStatus @default(PROVISIONING)
  plan          String       @default("standard")
  contactName   String?
  contactPhone  String?
  note          String?
  /// Direktorning logini (paroli saqlanmaydi — faqat korxona bazasida, hash holida)
  directorLogin String?
  /// Korxona ulangan ECO API (monitoring uchun /v1/health tekshiriladi)
  ecoApiUrl     String?
  suspendedAt   DateTime?
  suspendReason String?
  /// Oxirgi muvaffaqiyatli statistika so'rovi va natijasi
  lastSeenAt    DateTime?
  lastStats     Json?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  events ControlEvent[]
  stats  TenantStat[]
}

/// Superadmin amallari jurnali: korxona yaratish, to'xtatish, direktor parolini tiklash, SSO kirish...
model ControlEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  adminId   String?
  action    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  admin  SuperAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

/// Kunlik statistika surati (o'sish grafigi uchun). Bir korxona — bir kunda bitta qator (oxirgisi yoziladi).
model TenantStat {
  id       String   @id @default(cuid())
  tenantId String
  day      DateTime @db.Date
  stats    Json
  takenAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, day])
}

// ───────────────────────── Monitoring va kiberxavfsizlik (insof-agent) ─────────────────────────
//
// Panel serverga to'g'ridan-to'g'ri tegmaydi (insof-control.service: NoNewPrivileges, ProtectSystem=strict).
// Serverdagi alohida `insof-agent` xizmati (scripts/insof-agent.ts) metrikalarni yig'adi, tekshiruvlarni
// bajaradi va shu jadvallarga yozadi; panel o'qiydi va faqat AgentAction navbatiga so'rov qo'yadi.
// Agent navbatdagi amalni faqat oq ro'yxat (src/lib/control/monitor/contract.ts) bo'yicha bajaradi.

enum CheckStatus {
  OK
  WARN
  CRIT
  UNKNOWN
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKED // superadmin ko'rdi, ustida ishlanmoqda
  RESOLVED
}

enum ActionStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  REJECTED // oq ro'yxatda yo'q, parametr noto'g'ri yoki navbatda muddati o'tdi (xavfli amal > 10 daq)
  CANCELLED // superadmin navbatdan oldi (faqat PENDING holatidan)
}

/// Server holati surati (agent har ~15 s yozadi; 7 kundan eskilari agent tomonidan tozalanadi).
model HostSnapshot {
  id        String   @id @default(cuid())
  hostname  String
  takenAt   DateTime @default(now())
  cpuPct    Float
  load1     Float
  load5     Float
  load15    Float
  memTotal  BigInt
  memUsed   BigInt
  swapTotal BigInt
  swapUsed  BigInt
  diskTotal BigInt
  diskUsed  BigInt
  uptimeSec Int
  netRxBps  BigInt?
  netTxBps  BigInt?
  /// Qo'shimcha: jarayonlar soni, ochiq ulanishlar, top jarayonlar (xotira bo'yicha) va h.k.
  extra     Json?

  @@index([takenAt])
}

/// Tekshiruvning JORIY holati — har kalit uchun bitta qator (upsert). Tarix — Incident va HostSnapshot.
/// Kalitlar: contract.ts dagi checkKey() bilan yasaladi (masalan "unit:insof-erp@insof", "http:tenant:insof").
model ServiceCheck {
  id        String      @id @default(cuid())
  key       String      @unique
  /// unit | http | db | ssl | backup | disk | security | agent ...
  kind      String
  /// Inson o'qiydigan nom ("insof-erp@insof", "insof-erp.uz SSL")
  target    String
  tenantId  String?
  status    CheckStatus
  message   String?
  latencyMs Int?
  data      Json?
  checkedAt DateTime
  /// Holat shu qiymatga qachon o'tgan (OK → CRIT o'tishi vaqti)
  changedAt DateTime

  @@index([kind])
  @@index([status])
}

/// Hodisa: tekshiruv yiqildi yoki xavfsizlik topilmasi. Bir kalit — bitta ochiq hodisa (count oshadi).
model Incident {
  id               String         @id @default(cuid())
  key              String
  /// monitor | security | ai
  source           String
  /// availability | performance | security | backup | certificate | config | update
  category         String
  severity         Severity
  status           IncidentStatus @default(OPEN)
  title            String
  detail           Json?
  /// Tavsiya etilgan tuzatishlar: [{ type, params, label }] — contract.ts ActionType'lari
  suggestedActions Json?
  tenantId         String?
  count            Int            @default(1)
  firstSeenAt      DateTime       @default(now())
  lastSeenAt       DateTime       @default(now())
  resolvedAt       DateTime?
  ackedById        String?
  ackedAt          DateTime?
  /// Telegram ogohlantirishi yuborilgan vaqt (takror yubormaslik uchun)
  notifiedAt       DateTime?

  actions AgentAction[]

  @@index([status, severity])
  @@index([key, status])
  @@index([lastSeenAt])
}

/// Panel qo'ygan amal so'rovi — agent oq ro'yxat bo'yicha bajaradi va natijani yozadi.
model AgentAction {
  id            String       @id @default(cuid())
  /// contract.ts ACTION_TYPES dan biri
  type          String
  params        Json         @default("{}")
  status        ActionStatus @default(PENDING)
  requestedById String?
  requestedAt   DateTime     @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  /// stdout/stderr (oxirgi ~8 KB), sirlarsiz
  output        String?
  incidentId    String?

  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
}

/// Agent tirikligi (bitta qator, id = "main"). Panel "Agent javob bermayapti" ni shundan biladi.
model AgentHeartbeat {
  id         String   @id
  hostname   String
  version    String
  startedAt  DateTime
  lastSeenAt DateTime
  info       Json?
}

/// Kiberxavfsizlik AI tahlili (Claude): topilmalar bo'yicha qisqa hisobot va ustuvor tavsiyalar.
model SecurityReport {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  /// scheduled | manual
  trigger       String
  model         String
  /// Umumiy baho: A (yaxshi) … F (xavfli)
  grade         String
  summary       String
  /// [{ title, severity, why, fix, actionType? }]
  items         Json
  /// Tahlilga berilgan topilmalar soni va kirish hajmi (token emas, qisqa statistika)
  inputMeta     Json?
  requestedById String?

  @@index([createdAt])
}
