# Build vaqtidagi kalitlar — scripts/deploy.sh `npm run build` dan oldin shu fayldan o'qiydi (source qilinmaydi).
# Joyi serverda: /var/www/insof-erp/build.env   (cp build.env.example build.env && chmod 600 build.env)
#
# Nega alohida: platformada ildizda .env YO'Q (har korxona — tenants/<slug>.env). NEXT_PUBLIC_* kalitlar
# esa build paytida brauzer kodiga yoziladi va barcha korxonalar uchun bitta build — shuning uchun shu yerda.
# Korxona sirlari (AUTH_SECRET, API kalitlar, Telegram) bu yerga YOZILMAYDI.

# Yandex Tiles API kaliti — reyslar xaritasi tagligi (bo'sh bo'lsa OpenStreetMap). Brauzerga ochiq qiymat.
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# Ommaviy sayt ("/") build paytida statik tayyorlanadi va bazadan o'qiydi (kompaniya ma'lumoti, katalog),
# sitemap/robots esa APP_URL ni oladi. Shu sabab build'ga asosiy korxona bazasi va manzili kerak
# (faqat o'qiladi; qiymat brauzer kodiga tushmaydi). Bo'sh bo'lsa build "/" sahifasida xato berishi mumkin.
DATABASE_URL=postgresql://insof:PAROL@127.0.0.1:5432/insof_erp
APP_URL=https://insof-erp.uz

NEXT_TELEMETRY_DISABLED=1
