# ── Baza ──
# Standart: ERP o'z bazasida (lokal Postgres, 5432-port). <foydalanuvchi> o'rniga Postgres rolingizni yozing.
# Docker bilan ishlatsangiz: docker compose up -d  → postgresql://postgres:postgres@localhost:5432/insof_erp?schema=public
DATABASE_URL="postgresql://<foydalanuvchi>@localhost:5432/insof_erp?schema=public"
# Muhim: qiymatni faqat BITTA juft qo'shtirnoqqa oling. ""..."" bo'lsa dotenv uni bo'sh satr deb oladi
# va Prisma "the URL must start with postgresql://" xatosini beradi.
#
# Muqobil: ERP va ECO bitta bazada (ECO docker, 5438-port) — ECO jadvallari `public`, ERP jadvallari `erp` sxemasida.
# Ko'chirish: bash scripts/erp-to-eco-db.sh  (skript .env dagi DATABASE_URL ni o'zi quyidagiga almashtiradi)
# DATABASE_URL="postgresql://insof:insof@localhost:5438/insof?schema=erp"

AUTH_SECRET="change-me-to-a-long-random-string"   # openssl rand -base64 48 (har korxonada alohida)
APP_URL="http://localhost:3000"  # tashqi havolalar: nakladnoy QR, Telegram, sitemap. Telefon ochishi uchun LAN IP yoki domen bo'lsin
# PORT=3000                      # prodda systemd shu portda ishga tushiradi (korxona .env ida majburiy)
# NODE_ENV=production
# TZ=Asia/Tashkent

# ── Ko'p korxonali platforma (docs/deploy/PLATFORMA.md) ──
# Prodda ildizda .env bo'lmaydi: har korxona — tenants/<slug>.env (panel renderEnv yaratadi), panel — control.env.
# Korxona jarayoni (tenants/<slug>.env):
# TENANT_SLUG="insof"            # shu jarayon qaysi korxona (bo'sh — "insof")
# CONTROL_SSO_KEY=""             # IT panel SSO kaliti = HMAC(CONTROL_SECRET, slug): npm run -s tenant -- sso-key <slug>
#                                #   (eski o'rnatishlarda CONTROL_SECRET turgan bo'lsa ham ishlaydi — almashtirish tavsiya)
# UPLOADS_DIR="/var/lib/insof/<slug>/uploads"   # yuklangan fayllar (bo'sh — <ishchi papka>/uploads). Prodda MUTLAQ yo'l
# APK_PATH="/var/www/insof-erp/uploads/app/insof-eco.apk"   # Android APK (bo'sh — <UPLOADS ildizi>/app/insof-eco.apk)
# IOS_APP_URL="https://testflight.apple.com/join/XXXXXXXX"  # iPhone ilovasi: TestFlight ochiq havolasi, keyin App Store sahifasi (bo'sh — tugma yo'q)
#
# Markaziy IT panel (control.env, namuna: docs/deploy/control.env.example):
# INSOF_MODE="control"           # faqat panel jarayonida; korxonada bo'sh
# CONTROL_SECRET=""              # panelning SSO ildiz kaliti (≥32 belgi). Korxona .env iga YOZILMAYDI
# CONTROL_DATABASE_URL="postgresql://insof:PAROL@127.0.0.1:5432/insof_control"
# TENANT_DATABASE_URL="postgresql://insof:PAROL@127.0.0.1:5432/{db}"   # korxona bazalari shabloni
# TENANTS_DIR="/var/www/insof-erp/tenants"     # MUTLAQ yo'l (kod releases/<sha> dan ishlaydi)
# TENANT_DATA_ROOT="/var/lib/insof"            # yangi korxonalar fayllari ildizi
# TENANT_BASE_DOMAIN="insof-erp.uz"            # yangi korxona domeni taklifi: <slug>.insof-erp.uz
# CONTROL_ADMIN_PASSWORD=""      # npm run control:admin — parolni so'ramasdan berish (skript uchun)
# CONTROL_ENV_FILE="control.env" # npm run tenant — panel .env fayli yo'li
# GIT_COMMIT=""                  # odatda bo'sh: versiya releases/<sha>/RELEASE faylidan (/api/health, panel statistikasi)
# ENV_FILE="tenants/insof.env"   # skriptlar (bot, eco:sync, demo) qaysi korxona fayli bilan ishlasin

# ── Telegram bot (ovozli savol → AI javob) ──
TELEGRAM_BOT_TOKEN=""            # @BotFather dan olinadi
TELEGRAM_WEBHOOK_SECRET=""       # webhook himoyasi: openssl rand -hex 32 → so'ng: npm run bot:webhook -- https://<domen>
# Telegram Gateway (OTP): kirish, parol tiklash va ro'yxatdan o'tish kodlarini raqamning Telegramiga yuboradi.
# Bir martalik kodlarning YAGONA kanali — Telegram (bot ulangan bo'lsa — bot, aks holda Gateway).
# Token bo'sh bo'lsa botga ulanmagan xodim kod ololmaydi — u login+parol bilan kiradi.
# Token gateway.telegram.org dan olinadi; balans talab qiladi. Bo'sh bo'lsa kanal o'chiq. Tekshirish: npm run gateway
TELEGRAM_GATEWAY_TOKEN=""
TELEGRAM_GATEWAY_SENDER=""       # ixtiyoriy: tasdiqlangan kanal username (egalik shart)

# Ovozni matnga o'girish — bittasi yetarli (tanlash: mohir → groq → openai)
GROQ_API_KEY=""                  # BEPUL: console.groq.com, karta shart emas — sinov uchun
MOHIR_API_KEY=""                 # uzbekvoice.ai — o'zbek tili uchun eng aniq (450 so'm/daqiqa)
OPENAI_API_KEY=""                # OpenAI Whisper ($0.006/daqiqa)
# STT_PROVIDER="groq"            # mohir | groq | openai — avtomatik tanlovni bekor qilish
# MOHIR_STT_URL="https://uzbekvoice.ai/api/v1/stt"   # standart manzil (test muhitida — lokal stub)
# MOHIR_STT_LANGUAGE="uz"        # uz | ru | uz-ru
# MOHIR_STT_MODEL="general"      # general | enhanced-stt

# Erkin savollar — til modeli bazadan kerakli ma'lumotni ASBOBLAR orqali o'zi oladi (src/lib/ai/tools.ts):
# sana oralig'i, mijoz qidiruvi, ro'yxatlar, kassa, ombor, ishlab chiqarish, reyslar/nakladnoy.
# Bitta savol = 2–3 so'rov (~3 000 token har biri). Groq bepul tarifi daqiqasiga 8 000 token beradi —
# bitta savol sig'adi, ketma-ket savollar 429 bilan kutadi (kod o'zi kutib qayta urinadi).
# Jiddiy ishlatish uchun Claude kaliti (yoki Groq Dev tarifi) kerak. Kalit bo'lmasa — qoida asosidagi javoblar (0 token).
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=""                      # bo'sh — koddagi standart model (src/lib/ai/claude.ts)
# GROQ_CHAT_MODEL="openai/gpt-oss-20b"   # standart; openai/gpt-oss-120b — chuqurroq, lekin ko'p qismli savolni ba'zan qisqartiradi
# AI_PROVIDER="groq"                      # claude | groq — avtomatik tanlovni bekor qilish
# Terminaldan sinash: npm run ai -- "1-sentabrdan 10-sentabrgacha savdo qancha?"

# Nakladnoyni kamera bilan o'qish (Kirim → "Nakladnoyni skaner qilish"). Yuqoridagi kalitlardan biri yetarli:
# ANTHROPIC_API_KEY — eng aniq (qo'lda yozilgan hujjatni ham o'qiydi) · OPENAI_API_KEY · GROQ_API_KEY (bepul).
# Kalit bo'lmasa kamera tugmasi ko'rinmaydi, Excel va qo'lda kiritish ishlayveradi.
# VISION_PROVIDER="groq"          # claude | openai | groq — avtomatik tanlovni bekor qilish
# VISION_MODEL="qwen/qwen3.8-27b" # Groq'dagi rasmni o'qiydigan model (ro'yxat o'zgarsa shu yerda almashtiring)

# ── Insof ECO (haydovchi ilovasi) integratsiyasi ──
# ECO papkasida: yarn workspace @insof/api integration:create -- --org <zavod INN> --webhook http://<erp>/api/eco/webhook
ECO_API_URL="http://localhost:3010"  # ECO API manzili
ECO_API_KEY=""                       # integration:create bergan eco_… kalit (bo'sh bo'lsa integratsiya o'chiq)
ECO_WEBHOOK_SECRET=""                # ECO → ERP webhook imzosi (o'sha skript beradi)

# Yandex Tiles API kaliti — "Reyslar / nakladnoy" sahifasidagi jonli xarita tagligi.
# Olish: https://developer.tech.yandex.ru → "Подключить API" → **Tiles API** (JS API emas!).
# Tiles API tijorat va yopiq tizimlar uchun bepul (30 so'rov/sekund); JS API esa bizning
# holatimizda yillik litsenziya talab qiladi. Bo'sh qoldirilsa xarita OpenStreetMap'da ishlaydi.
NEXT_PUBLIC_YANDEX_MAPS_KEY=""   # prod platformada build.env da (build.env.example) — brauzer kodiga build paytida yoziladi

# Yandex manzil qidiruvi — zayavka/obyekt formasidagi "manzil yozganda takliflar".
# Ikkalasi ham kerak: Geosadjest takliflar ro'yxatini beradi, Geokoder tanlangan manzilning nuqtasini.
# Olish: https://developer.tech.yandex.ru → "Подключить API" → **API Геосаджеста** va **API Геокодера**.
# Bo'sh qoldirilsa qidiruv 2GIS'da (DGIS_API_KEY) ishlaydi; Yandex hech narsa topmasa ham 2GIS'ga tushadi.
YANDEX_SUGGEST_KEY=""
YANDEX_GEOCODER_KEY=""

# Yandex marshrut — "API Получения деталей маршрута". Haydovchi ilovasidagi yo'l chizig'i,
# qolgan km/vaqt (tirbandlik bilan) va zayavkadagi zavoddan masofa shu bilan hisoblanadi.
# Bo'sh qoldirilsa yoki javob bermasa OSRM (OSRM_URL), u ham bo'lmasa to'g'ri chiziq.
YANDEX_ROUTER_KEY=""

# 2GIS — manzil qidiruvi va geokoder zaxirasi (Yandex kaliti bo'lmasa yoki topilmasa)
DGIS_API_KEY=""
# OSRM marshrut serveri. Bo'sh — ochiq router.project-osrm.org (sekin, kafolatsiz). O'zingizniki: scripts/osrm-setup.sh
# OSRM_URL="http://127.0.0.1:5000"

# ── Mobil ilova (Insof ECO) push-xabarlari ──
EXPO_ACCESS_TOKEN=""             # expo.dev → Access tokens (bo'sh ham ishlaydi, lekin cheklovli)

# ── Seed / demo / test skriptlari (scripts/demo-guard.ts) ──
# db:seed, db:reset, db:demo, db:test-users, shop-demo faqat lokal test bazasida (insof_test…) ishlaydi.
# Boshqa bazada — faqat aniq bayroq bilan:
# ALLOW_DEMO="yes-i-know"
# Test bo'lmagan bazada standart parol YO'Q — kamida 10 belgili parollar majburiy:
# ADMIN_LOGIN="direktor"         # db:reset (va db:seed) yaratadigan direktor logini
# ADMIN_PASSWORD=""              # (eski nomi SEED_ADMIN_PASSWORD ham o'qiladi)
# ADMIN_NAME="Direktor"
# SEED_STAFF_PASSWORD=""         # db:seed namunaviy xodimlari paroli
# TEST_USER_PASSWORD=""          # faqat test rejimi (INSOF_ENV=test): test.* loginlar paroli

# ── Mobil ilova: "Yetib keldim" / "Tushirishni boshladim" / "Yetkazdim" joy tekshiruvi (src/lib/mobile/geofence.ts) ──
# POST /api/mobile/action payload'ida haydovchining hozirgi joylashuvi { lat, lng } bo'lishi shart va obyektdan
# 300 m ichida bo'lishi kerak (zayavkada koordinata bo'lsa). Koordinatasiz (eski ilova) so'rov — 426 APP_UPDATE_REQUIRED
# "Ilovani yangilang". Yangi ilova do'konga chiqquncha vaqtincha "false" qilinsa, koordinatasiz so'rov eski
# qoidaga (saqlangan GPS izi, 1 km) qoladi; koordinata YUBORILSA 300 m baribir tekshiriladi.
MOBILE_SITE_COORDS_REQUIRED=false

# ── GPS davriy tekshiruvi (src/lib/gps-watch.ts) — korxona jarayoni ichida har daqiqada ──
# Yo'ldagi reys: "GPS jim", "uzoq turibdi", "yo'ldan chiqdi" → logistikaga bir marta push; kuniga bir marta
# 90 kundan eski GPS nuqtalari o'chiriladi (yakuni saqlangan reyslarniki). Cron/systemd timer SHART EMAS.
# "off" — o'chirish (masalan tekshiruvni `npm run gps:watch` bilan cron'dan yuritmoqchi bo'lsangiz). Test rejimida sukut — o'chiq ("on" — yoqish).
# GPS_WATCH=""

# ── Mobil yuz skaneri: "Keldim/Ketdim" va rahbarning att.face (src/lib/face-replay.ts) ──
# Ilova kadrdan oldin GET /api/mobile/attendance/challenge dan bir martalik nonce oladi (2 daq, bir marta).
# Nonce yuborilsa — har doim tekshiriladi. "true" — nonce'siz so'rov rad (400 NONCE_REQUIRED "Ilovani yangilang");
# challenge'ni yuboradigan ilova versiyasi hammada o'rnatilgach yoqing. Kadr xeshi (bir xil kadr qayta) — har doim rad.
MOBILE_FACE_NONCE_REQUIRED=false
# Server Face ID hisobi (tfjs WASM) bir vaqtda nechta kadr — 1 (standart) yoki 2; qolganlari navbatda (12 s gacha)
# FACE_CONCURRENCY=1
