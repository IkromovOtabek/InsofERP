# ── Baza ──
# Standart: ERP o'z bazasida (lokal Postgres, 5432-port). <foydalanuvchi> o'rniga Postgres rolingizni yozing.
# Docker bilan ishlatsangiz: docker compose up -d  → postgresql://postgres:postgres@localhost:5432/insof_erp?schema=public
DATABASE_URL="postgresql://<foydalanuvchi>@localhost:5432/insof_erp?schema=public"
# Muhim: qiymatni faqat BITTA juft qo'shtirnoqqa oling. ""..."" bo'lsa dotenv uni bo'sh satr deb oladi
# va Prisma "the URL must start with postgresql://" xatosini beradi.
#
# Muqobil: ERP va ECO bitta bazada (ECO docker, 5438-port) — ECO jadvallari `public`, ERP jadvallari `erp` sxemasida.
# Ko'chirish: bash scripts/erp-to-eco-db.sh  (skript .env dagi DATABASE_URL ni o'zi quyidagiga almashtiradi)
# DATABASE_URL="postgresql://insof:insof@localhost:5438/insof?schema=erp"

AUTH_SECRET="change-me-to-a-long-random-string"

# ── Telegram bot (ovozli savol → AI javob) ──
TELEGRAM_BOT_TOKEN=""            # @BotFather dan olinadi
TELEGRAM_WEBHOOK_SECRET=""       # webhook himoyasi uchun tasodifiy satr
APP_URL="http://localhost:3000"  # tashqi havolalar: nakladnoy QR, Telegram. Telefon ochishi uchun LAN IP yoki domen bo'lsin

# Ovozni matnga o'girish — bittasi yetarli (tanlash: mohir → groq → openai)
GROQ_API_KEY=""                  # BEPUL: console.groq.com, karta shart emas — sinov uchun
MOHIR_API_KEY=""                 # uzbekvoice.ai — o'zbek tili uchun eng aniq (450 so'm/daqiqa)
OPENAI_API_KEY=""                # OpenAI Whisper ($0.006/daqiqa)
# STT_PROVIDER="groq"            # avtomatik tanlovni bekor qilish

# Erkin savollar — til modeli bazadan kerakli ma'lumotni ASBOBLAR orqali o'zi oladi (src/lib/ai/tools.ts):
# sana oralig'i, mijoz qidiruvi, ro'yxatlar, kassa, ombor, ishlab chiqarish, reyslar/nakladnoy.
# Bitta savol = 2–3 so'rov (~3 000 token har biri). Groq bepul tarifi daqiqasiga 8 000 token beradi —
# bitta savol sig'adi, ketma-ket savollar 429 bilan kutadi (kod o'zi kutib qayta urinadi).
# Jiddiy ishlatish uchun Claude kaliti (yoki Groq Dev tarifi) kerak. Kalit bo'lmasa — qoida asosidagi javoblar (0 token).
ANTHROPIC_API_KEY=""
# GROQ_CHAT_MODEL="openai/gpt-oss-20b"   # standart; openai/gpt-oss-120b — chuqurroq, lekin ko'p qismli savolni ba'zan qisqartiradi
# AI_PROVIDER="groq"                      # claude | groq — avtomatik tanlovni bekor qilish
# Terminaldan sinash: npm run ai -- "1-sentabrdan 10-sentabrgacha savdo qancha?"

# Nakladnoyni kamera bilan o'qish (Kirim → "Nakladnoyni skaner qilish"). Yuqoridagi kalitlardan biri yetarli:
# ANTHROPIC_API_KEY — eng aniq (qo'lda yozilgan hujjatni ham o'qiydi) · OPENAI_API_KEY · GROQ_API_KEY (bepul).
# Kalit bo'lmasa kamera tugmasi ko'rinmaydi, Excel va qo'lda kiritish ishlayveradi.
# VISION_PROVIDER="groq"          # claude | openai | groq — avtomatik tanlovni bekor qilish
# VISION_MODEL="qwen/qwen3.8-27b" # Groq'dagi rasmni o'qiydigan model (ro'yxat o'zgarsa shu yerda almashtiring)

# ── Insof ECO (haydovchi ilovasi) integratsiyasi ──
# ECO papkasida: yarn workspace @insof/api integration:create -- --org <zavod INN> --webhook http://<erp>/api/eco/webhook
ECO_API_URL="http://localhost:3010"  # ECO API manzili
ECO_API_KEY=""                       # integration:create bergan eco_… kalit (bo'sh bo'lsa integratsiya o'chiq)
ECO_WEBHOOK_SECRET=""                # ECO → ERP webhook imzosi (o'sha skript beradi)
