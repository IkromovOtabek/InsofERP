# ─────────────────────────────────────────────────────────────────────────────
# Insof ERP — LOKAL TEST MUHITI (AI QA agentlari, E2E). Namuna: faqat soxta yoki bo'sh qiymatlar.
#
# Nusxa: cp .env.test.example .env.test   (.env.test repoga kirmaydi)
#
# MUHIM: Next `.env.test` dan keyin `.env` ni ham o'qiydi — bu yerda YO'Q kalit `.env` dagi real
# qiymatni oladi. Shuning uchun quyidagi kalitlarning hech birini o'chirmang: bo'sh qiymat ham
# "berilgan" hisoblanadi va `.env` dagidan ustun turadi. Real kalit topilsa server ishga tushmaydi
# (src/lib/test-mode.ts → assertSafeTestEnv, src/instrumentation.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Rejim
INSOF_ENV=test
TZ=Asia/Tashkent
NEXT_TELEMETRY_DISABLED=1

# Baza — faqat lokal, nomi insof_test… (test bazasi keyingi bosqichda: docker, port 5433)
DATABASE_URL="postgresql://insof_test:insof_test@127.0.0.1:5433/insof_test?schema=public&connection_limit=5"

# Ilova — prod'dan farqli, faqat testga xos kalit (openssl rand -base64 48)
AUTH_SECRET="test-only-secret-change-me-0123456789abcdefghijklmnop"
APP_URL="http://localhost:3100"

# SMS — faqat FAKE (jurnalga SKIPPED, konsolga matn)
SMS_PROVIDER=FAKE
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=
RESET_SMS_FALLBACK=

# Telegram — o'chiq
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ECO_TELEGRAM_BOT_TOKEN=
# Telegram Gateway (OTP) — test rejimida bo'sh bo'lishi SHART (aks holda server ishga tushmaydi)
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_SENDER=

# Insof ECO — chiquvchi API o'chiq; kiruvchi webhook faqat test siri bilan simulyatsiya qilinadi
ECO_API_URL=
ECO_API_KEY=
ECO_WEBHOOK_SECRET="test-eco-webhook-secret"
ECO_STUB_URL=

# Push (Expo)
EXPO_ACCESS_TOKEN=

# AI / LLM / vision / ovoz — o'chiq (qoidaga asoslangan javob ishlaydi)
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GROQ_API_KEY=
GROQ_CHAT_MODEL=
OPENAI_API_KEY=
VISION_PROVIDER=
VISION_MODEL=
STT_PROVIDER=
MOHIR_API_KEY=
MOHIR_STT_URL=
MOHIR_STT_MODEL=
MOHIR_STT_LANGUAGE=

# Xarita / geo — 2GIS o'chiq, OSRM ochiq serverga ketmasin (yopiq lokal port → to'g'ri chiziq hisobi)
DGIS_API_KEY=
OSRM_URL="http://127.0.0.1:9"
NEXT_PUBLIC_YANDEX_MAPS_KEY=
YANDEX_SUGGEST_KEY=
YANDEX_GEOCODER_KEY=
YANDEX_ROUTER_KEY=

# Ishlatilmaydi, lekin .env dan kirib qolmasin
AMO_BASE_URL=
