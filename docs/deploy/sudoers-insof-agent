# /etc/sudoers.d/insof-deploy — `deploy` foydalanuvchisiga parolsiz ruxsat etilgan buyruqlar (deploy.sh va insof-agent).
# Mavjud /etc/sudoers.d/insof-deploy (PLATFORMA.md 1-qadam) shu fayl bilan ALMASHTIRILADI — eski 3 ta restart qatori shu yerda bor.
#
# O'rnatish (avval tekshirib, keyin joyiga — buzuq sudoers butun sudo'ni o'chirib qo'yadi):
#   sudo install -m 440 -o root -g root docs/deploy/sudoers-insof-agent /etc/sudoers.d/insof-deploy.new
#   sudo visudo -cf /etc/sudoers.d/insof-deploy.new && sudo mv /etc/sudoers.d/insof-deploy.new /etc/sudoers.d/insof-deploy
#   sudo visudo -c                       # butun konfiguratsiya: "parsed OK"
#   sudo -l -U deploy                    # ro'yxat shu fayldagi bilan bir xil
# Fayl nomida nuqta bo'lmasin — sudo "insof-deploy.new" kabi nuqtali fayllarni o'qimaydi (vaqtinchalik nom shuning uchun xavfsiz).
#
# Yo'llar Ubuntu 22.04 uchun (`command -v systemctl nginx ufw certbot` bilan tekshiring). Agent buyruqlarni aynan shu
# to'liq yo'llar bilan, `sudo -n` (parol so'ramasdan) va shell'siz chaqiradi; argumentlar agentda regex bilan tekshiriladi
# (unit: insof-erp@<slug>|insof-control|insof-eco, ip: faqat IPv4).
#
# Eslatma: sudoers'dagi `*` bo'sh joyni ham qamraydi (masalan `systemctl restart insof-erp@a nginx` ham mos keladi).
# Ubuntu 22.04 dagi sudo 1.9.9 da regex yo'q — shuning uchun argumentli restart va ufw buyruqlari to'g'ridan-to'g'ri
# emas, ROOT EGALIGIDAGI o'ramlar orqali: /usr/local/sbin/insof-restart va /usr/local/sbin/insof-ufw (scripts/*.sh dan
# `install -o root -m 755`). O'ram argumentlar sonini, qat'iy regex'ni tekshiradi va buyruqni `--` bilan chaqiradi;
# shuning uchun bu yerdagi `*` qolgan bo'lsa ham `insof-erp@a nginx` kabi qo'shimcha argument o'tmaydi.
# Tartib: AVVAL o'ramlarni o'rnating, KEYIN shu faylni (aks holda deploy.sh/agent restart qila olmaydi).

# IT panel → Relizlar (DEPLOY/ROLLBACK) uchun qo'shimcha qator YO'Q: deploy.sh deploy ostida ishlaydi va faqat
# INSOF_RESTART dagi restartlarni (insof-restart o'rami orqali) chaqiradi; journalctl va nginx loglari — systemd-journal/adm guruhlari orqali (sudo'siz).

Cmnd_Alias INSOF_RESTART = /usr/local/sbin/insof-restart insof-erp@[a-z0-9]*, \
                           /usr/local/sbin/insof-restart insof-control, \
                           /usr/local/sbin/insof-restart insof-eco, \
                           /usr/local/sbin/insof-restart insof-agent
Cmnd_Alias INSOF_NGINX   = /usr/sbin/nginx -t, \
                           /usr/bin/systemctl reload nginx
# certbot: apt paketi /usr/bin/certbot, snap — /snap/bin/certbot (qaysi biri o'rnatilgan bo'lsa, agent o'shani chaqiradi)
Cmnd_Alias INSOF_CERT    = /usr/bin/certbot renew --quiet, \
                           /snap/bin/certbot renew --quiet
Cmnd_Alias INSOF_UFW     = /usr/local/sbin/insof-ufw deny [0-9]*, \
                           /usr/local/sbin/insof-ufw undeny [0-9]*, \
                           /usr/sbin/ufw status, \
                           /usr/sbin/ufw status verbose

deploy ALL=(root) NOPASSWD: INSOF_RESTART, INSOF_NGINX, INSOF_CERT, INSOF_UFW

# ── Infratuzilma (scripts/agent/infra.ts; PLATFORMA.md → «Infratuzilma») ──
# Qayta yuklash: "now" → +1 daqiqa (natija yozilsin, bekor qilish imkoni qolsin), yoki HH:MM; bekor qilish -c.
# Jurnal: faqat 14 kundan eskisini o'chirish. Korxonani ishga tushirish: FAQAT root egaligidagi /usr/local/sbin nusxasi
# (repo'dagi scripts/tenant-up.sh EMAS — uni deploy o'zgartira oladi); argumentlarni skript regex bilan tekshiradi.
Cmnd_Alias INSOF_REBOOT  = /usr/sbin/shutdown -r +1, \
                           /usr/sbin/shutdown -r [0-2][0-9]\:[0-5][0-9], \
                           /usr/sbin/shutdown -c
Cmnd_Alias INSOF_JOURNAL = /usr/bin/journalctl --vacuum-time=14d
Cmnd_Alias INSOF_TENANT  = /usr/local/sbin/insof-tenant-up [a-z]*

deploy ALL=(root) NOPASSWD: INSOF_REBOOT, INSOF_JOURNAL, INSOF_TENANT
