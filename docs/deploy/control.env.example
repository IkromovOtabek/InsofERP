# Markaziy IT panel jarayoni (/var/www/insof-erp/control.env, chmod 600)
NODE_ENV=production
TZ=Asia/Tashkent
INSOF_MODE=control
# Panelning o'z sessiya kaliti (korxonalarnikidan farqli): openssl rand -base64 48
AUTH_SECRET=
# Panel ↔ korxona SSO ildiz kaliti: openssl rand -base64 48 (kamida 32 belgi). FAQAT shu faylda turadi.
# Har korxona .env iga uning hosilasi yoziladi: CONTROL_SSO_KEY = HMAC-SHA256(CONTROL_SECRET, slug)
# (panel yangi korxonada o'zi yozadi; qo'lda: npm run -s tenant -- sso-key <slug>).
# Bu qiymat almashtirilsa — barcha korxonalarning CONTROL_SSO_KEY ham qayta yozilishi kerak.
CONTROL_SECRET=
# Control baza (korxonalar ro'yxati, superadminlar, jurnal)
CONTROL_DATABASE_URL=postgresql://insof:PAROL@127.0.0.1:5432/insof_control
# Korxona bazalari shabloni — {db} o'rniga baza nomi qo'yiladi. Foydalanuvchida CREATEDB huquqi bo'lsin.
# Yangi korxona .env idagi DATABASE_URL shu shablondan yoziladi. connection_limit — har korxona jarayonining
# Prisma puli: standart (CPU*2+1) bilan 5–6 korxona Postgres'ning 100 ulanish chegarasiga yetadi.
TENANT_DATABASE_URL=postgresql://insof:PAROL@127.0.0.1:5432/{db}?connection_limit=5
# Prisma klienti shu o'zgaruvchini kutadi (panel korxona bazasiga TENANT_DATABASE_URL orqali ulanadi)
DATABASE_URL=postgresql://insof:PAROL@127.0.0.1:5432/insof_control
# Korxonalarning .env fayllari va ma'lumot papkasi — MUTLAQ yo'l (kod releases/<sha> dan ishlaydi)
TENANTS_DIR=/var/www/insof-erp/tenants
TENANT_DATA_ROOT=/var/lib/insof
# Yangi korxona domeni avtomatik taklifi: <slug>.insof-erp.uz
TENANT_BASE_DOMAIN=insof-erp.uz
