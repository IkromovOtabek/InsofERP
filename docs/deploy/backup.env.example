# Insof zaxira nusxa, tiklash sinovi va kuzatuv sozlamasi.
# Joyi: /etc/insof/backup.env   (sudo install -d -m 750 -o root -g deploy /etc/insof
#                               sudo install -m 640 -o root -g deploy docs/deploy/backup.env.example /etc/insof/backup.env)
# O'qiydi: scripts/server-backup.sh, scripts/restore-test.sh, scripts/health-watch.sh
# Fayl `source` qilinmaydi — faqat quyidagi KALIT=qiymat qatorlari o'qiladi.

# ── Joylar ──
APP_DIR=/var/www/insof-erp           # repo: control.env va tenants/*.env shu yerda
OUT_DIR=/var/backups/insof           # mahalliy nusxalar: <OUT_DIR>/<YYYY-MM-DD_HHMM>/
KEEP_DAYS=14                         # mahalliy saqlash (kun)
BACKUP_UPLOADS=1                     # 1 — har korxonaning fayllar papkasi ham arxivlanadi

# ── Server tashqarisiga nusxa: rclone | restic | local | none ──
# none  — faqat shu serverda (TAVSIYA ETILMAYDI: disk yonsa ikkalasi ketadi)
# local — OFFSITE_DIR papkasiga (boshqa disk / mount qilingan tarmoq papkasi), SHA256 bilan tekshiriladi
# Tanlangan vosita o'rnatilmagan/sozlanmagan bo'lsa: mahalliy nusxa olinadi, lekin skript exit 1 + ogohlantirish.
OFFSITE=rclone
# OFFSITE_DIR=/mnt/backup-disk/insof
# OFFSITE_KEEP_DAYS=30

# rclone: avval `rclone config` (deploy foydalanuvchisi ostida) bilan masofa yarating —
# Backblaze B2, S3, Yandex Object Storage, Google Drive... Masalan "b2:insof-backup/prod"
RCLONE_REMOTE=
RCLONE_KEEP_DAYS=30                  # masofadagi nusxalar necha kun saqlansin
# RCLONE_CONFIG=/home/deploy/.config/rclone/rclone.conf

# restic (alternativa — shifrlangan, takrorlanmas bo'laklar): restic init bilan ombor yarating
# RESTIC_REPOSITORY=s3:https://s3.example.com/insof-backup
# RESTIC_PASSWORD_FILE=/etc/insof/restic.pass     # chmod 600; parolni server TASHQARISIDA ham saqlang!
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# RESTIC_KEEP_DAILY=14
# RESTIC_KEEP_WEEKLY=8
# RESTIC_KEEP_MONTHLY=6

# ── Telegram ogohlantirish (zaxira xatosi, tiklash sinovi, health-watch) ──
# Alohida bot (@BotFather) tavsiya etiladi — korxona botlari bilan aralashtirmang.
# Chat ID: botga /start yozing → https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id":...}
ALERT_TG_BOT_TOKEN=
ALERT_TG_CHAT_ID=
